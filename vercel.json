{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "regions": ["sin1"],
  "functions": {
    "src/app/api/upload/video/transcode/route.ts": {
      "memory": 2048,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-reminders",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/saved-search-alerts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/warm-translations",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 2 * * 4"
    },
    {
      "path": "/api/cron/price-stats",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/video-gc",
      "schedule": "30 3 * * *"
    }
  ]
}
