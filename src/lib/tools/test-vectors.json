  "spec": {
    "version": 1,
    "slug": "shared-home-cost-split",
    "title": {
      "en": "Shared home cost splitter",
      "vi": "Chia tiền nhà ở ghép"
    },
    "description": {
      "en": "Split the rent and the monthly bills of a shared home between the people living there, and see each share for a year.",
      "vi": "Chia tiền thuê và các khoản phí hằng tháng của căn nhà ở ghép cho từng người, và xem mỗi người trả bao nhiêu trong một năm."
    },
    "intro": {
      "en": "Each person's share is the rent plus the monthly bills, divided by the number of people. Enter what your contract and your bills say, choose how many people share the home, and see each share for a month and for a year.",
      "vi": "Phần của mỗi người là tiền thuê cộng các khoản phí hằng tháng, chia cho số người ở. Nhập đúng số tiền trong hợp đồng và hóa đơn, chọn số người ở cùng, rồi xem mỗi người trả bao nhiêu mỗi tháng và mỗi năm."
    },
    "howItWorks": {
      "en": "The rent and the monthly bills are added together, then divided equally between the people who share the home.\n\nThe yearly figure is the monthly share times 12. It assumes the rent and the bills stay the same all year.",
      "vi": "Tiền thuê và các khoản phí hằng tháng được cộng lại, rồi chia đều cho những người ở cùng.\n\nCon số cả năm bằng phần mỗi tháng nhân 12. Công cụ giả định tiền thuê và các khoản phí không đổi trong năm."
    },
    "limitations": {
      "en": "It splits everything equally, not by the size of each room.\nBills that change from month to month are an estimate: use an average.",
      "vi": "Công cụ chia đều cho mọi người, không theo diện tích từng phòng.\nCác khoản phí thay đổi theo tháng chỉ là ước tính: hãy dùng mức trung bình."
    },
    "inputs": [
      {
        "id": "rent",
        "kind": "money",
        "label": {
          "en": "Monthly rent",
          "vi": "Tiền thuê mỗi tháng"
        },
        "help": {
          "en": "The rent in the contract, for the whole home.",
          "vi": "Tiền thuê ghi trong hợp đồng, cho cả căn."
        },
        "default": 12000000,
        "min": 100000,
        "max": 10000000000
      },
      {
        "id": "bills",
        "kind": "money",
        "label": {
          "en": "Monthly bills",
          "vi": "Phí hằng tháng"
        },
        "help": {
          "en": "Electricity, water, internet and management fees, added up.",
          "vi": "Điện, nước, internet và phí quản lý, cộng lại."
        },
        "default": 1500000,
        "min": 0,
        "max": 1000000000
      },
      {
        "id": "people",
        "kind": "choice",
        "label": {
          "en": "People sharing",
          "vi": "Số người ở"
        },
        "help": {
          "en": "Everyone who pays a share.",
          "vi": "Những người cùng chia tiền."
        },
        "default": 2,
        "min": 2,
        "max": 5,
        "choices": [
          {
            "value": 2,
            "label": {
              "en": "2 people",
              "vi": "2 người"
            }
          },
          {
            "value": 3,
            "label": {
              "en": "3 people",
              "vi": "3 người"
            }
          },
          {
            "value": 4,
            "label": {
              "en": "4 people",
              "vi": "4 người"
            }
          },
          {
            "value": 5,
            "label": {
              "en": "5 people",
              "vi": "5 người"
            }
          }
        ]
      }
    ],
    "outputs": [
      {
        "id": "perPerson",
        "label": {
          "en": "Each person pays a month",
          "vi": "Mỗi người trả mỗi tháng"
        },
        "formula": "(rent + bills) / people",
        "format": "money"
      },
      {
        "id": "total",
        "label": {
          "en": "The whole home a month",
          "vi": "Cả căn mỗi tháng"
        },
        "formula": "rent + bills",
        "format": "money"
      },
      {
        "id": "perPersonYear",
        "label": {
          "en": "Each person pays a year",
          "vi": "Mỗi người trả mỗi năm"
        },
        "formula": "perPerson * 12",
        "format": "money"
      }
    ],
    "notes": [
      {
        "when": "bills > rent",
        "text": {
          "en": "The bills are more than the rent: check the figures.",
          "vi": "Phí hằng tháng cao hơn tiền thuê: hãy kiểm tra lại các số."
        }
      }
    ],
    "example": {
      "inputs": {
        "rent": 12000000,
        "bills": 1500000,
        "people": 2
      }
    },
    "tests": [
      {
        "inputs": {
          "rent": 12000000,
          "bills": 1500000,
          "people": 2
        },
        "expect": {
          "perPerson": 6750000,
          "total": 13500000,
          "perPersonYear": 81000000
        }
      },
      {
        "inputs": {
          "rent": 9000000,
          "bills": 600000,
          "people": 3
        },
        "expect": {
          "perPerson": 3200000,
          "perPersonYear": 38400000
        }
      },
      {
        "inputs": {
          "rent": 20000000,
          "bills": 2000000,
          "people": 4
        },
        "expect": {
          "perPerson": 5500000,
          "perPersonYear": 66000000
        }
      }
    ],
    "faqs": [
      {
        "q": {
          "en": "Does it split by room size?",
          "vi": "Công cụ có chia theo diện tích phòng không?"
        },
        "a": {
          "en": "No. It splits the rent and the bills equally. If one room is bigger, agree a different split between you and use it instead.",
          "vi": "Không. Công cụ chia đều tiền thuê và các khoản phí. Nếu có phòng rộng hơn, hãy tự thỏa thuận cách chia khác."
        }
      },
      {
        "q": {
          "en": "What counts as monthly bills?",
          "vi": "Phí hằng tháng gồm những gì?"
        },
        "a": {
          "en": "Whatever the home costs each month on top of the rent: electricity, water, internet, management and parking fees.",
          "vi": "Mọi khoản phải trả mỗi tháng ngoài tiền thuê: điện, nước, internet, phí quản lý và phí gửi xe."
        }
      },
      {
        "q": {
          "en": "Is anything I type stored?",
          "vi": "Những gì tôi nhập có được lưu không?"
        },
        "a": {
          "en": "No. The calculator runs in your browser, and nothing you type is stored or sent anywhere.",
          "vi": "Không. Công cụ chạy trên trình duyệt của bạn, và những gì bạn nhập không được lưu hay gửi đi đâu."
        }
      }
    ],
    "related": [
      "/c/rentals",
      "/move-in-cost-calculator"
    ]
  },
