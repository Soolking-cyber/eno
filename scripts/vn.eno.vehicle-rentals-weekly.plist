<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  eno.vn HCMC vehicle-rental refresh (scripts/vehicle-rentals-weekly.sh) — EVERY 3 DAYS, triggered DAILY at 04:30.
  Owner 2026-10-13: "every 3 days it should check and update". launchd has no "every N days": the trigger is daily and
  the script runs only when the last SUCCESSFUL run STARTED ≥ 66 h ago (src/lib/vehicle-job-gate.ts) — a failed or
  refused run retries the next morning, and a trigger missed while the Mac slept fires on wake. A not-due day logs one
  line. One run at a time: the lock is ~/.eno-vehicle-refresh.lock (a holder that is not a running refresh is cleared).
  The label and file name keep "weekly" so the installed agent's label and the worktree path stay valid.
  It runs from ~/eno-vehicles-job, a CLEAN detached worktree at origin/main (ENO_REPO) — fast-forward it after an
  importer change: git -C ~/eno-vehicles-job fetch && git -C ~/eno-vehicles-job checkout --detach origin/main, then
  prisma generate there. The env (DB + storage) comes from ~/eno.vn/.env (VEH_ENV_FILE); the DB tunnel is
  scripts/db-tunnel.sh (supervised).
  ⛔ ORDER: fast-forward ~/eno-vehicles-job FIRST, then load this plist. The pre-2026-10-13 script there has no 66 h
  gate: under this daily trigger it would scrape and import every single day.
  Install / reload (owner):
    mkdir -p ~/eno-import-journals/vehicles   # launchd will not start a job whose log dir is missing
    launchctl unload ~/Library/LaunchAgents/vn.eno.vehicle-rentals-weekly.plist 2>/dev/null
    cp ~/eno-vehicles-job/scripts/vn.eno.vehicle-rentals-weekly.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/vn.eno.vehicle-rentals-weekly.plist
  Remove: launchctl unload ~/Library/LaunchAgents/vn.eno.vehicle-rentals-weekly.plist
  The script holds its own caffeinate (-i, and -s on AC) for the hours a run takes (1 req/s per host).
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>vn.eno.vehicle-rentals-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/mk1e3/eno-vehicles-job/scripts/vehicle-rentals-weekly.sh</string>
    <string>--apply</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>EnvironmentVariables</key>
  <dict><key>ENO_REPO</key><string>/Users/mk1e3/eno-vehicles-job</string><key>VEH_ENV_FILE</key><string>/Users/mk1e3/eno.vn/.env</string><key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>WorkingDirectory</key><string>/Users/mk1e3/eno-vehicles-job</string>
  <key>StandardOutPath</key><string>/Users/mk1e3/eno-import-journals/vehicles/weekly.log</string>
  <key>StandardErrorPath</key><string>/Users/mk1e3/eno-import-journals/vehicles/weekly.log</string>
</dict>
</plist>
