# dependencies — unanchored so nested workspaces (apps/*/node_modules) are covered too.
# (The root-only `/node_modules` let apps/forum/node_modules get committed — a 114MB swc
# binary — which GitHub's pre-receive hook rejects. Never commit deps/build artifacts.)
node_modules/
/.pnp
.pnp.*

# next.js — unanchored: also catches apps/*/.next
.next/
# Isolated build dirs from NEXT_DIST_DIR (see next.config.ts): lets a dev server and a
# production preview run from one checkout without overwriting each other's .next.
.next-*/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# env & secrets — NEVER commit
.env
.env*.local
.env.production
*.pem
*.key

# local database
/db/*.db
/db/*.db-journal

# logs
*.log
dev.log
server.log

# os / editor
.DS_Store
.vscode/
.idea/

# misc
/coverage
/scratch
/tool-results
/download
/upload

# Azure deployment templates (contain subscription/resource ids)
Deployment-*/
.vercel

# Prisma 7 generated client (regenerated on install/build)
/src/generated/prisma/

# ⚠️ GENERATED ICON GEOMETRY — NOT COMMITTED, AND THE REASON IS REVIEWABILITY.
# `npm run icons` emits ~930 KB of Solar path data across these two files: 243 icons x 2 weights,
# as single 4 KB lines. That is machine output nobody reads, and committing it made every diff
# that touched icons UNREVIEWABLE — measured 2026-08-12, codex refused the diff outright and agy
# truncated at its 180 KB argv cap, so the second-opinion gate could not reach quorum on a commit
# that was otherwise fine. Same treatment, same reason, as the Prisma client above.
# Regenerated by postinstall, by `npm run build` and by every `dev` script, so a fresh clone is
# covered without anyone remembering. The per-glyph SVGs under public/icons/** stay committed: they
# are small, human-checkable, and the artwork a reviewer would actually want to see.
/src/components/ui/icons.tsx
/src/generated/icon-paths.ts
# ⚠️ THE SPRITE IS THE SAME MACHINE OUTPUT AND BELONGS ON THIS SIDE OF THE LINE, even though it
# lives under public/icons/** where the rule above keeps things. It is ONE 681 KB file holding all
# 243 glyphs x 2 weights as `<symbol>`s (2026-08-14) — not small and not human-checkable, i.e. the
# exact diff that made codex refuse and blew agy's argv cap. It is emitted by the same generator on
# the same three hooks, and the Dockerfile / scripts/preview.mjs both copy public/ after
# `npm run build` has run it.
# ⚠️ THE NAME IS STABLE, NOT CONTENT-HASHED, AND THAT IS LOAD-BEARING RATHER THAN LAZY — a hashed
# name 404s out of edge-cached HTML after a deploy and a `<use>` whose target 404s draws NOTHING.
# The reasoning is in scripts/gen-icons.mjs; do not "improve" it by adding the hash back.
/public/icons/glyphs.svg
/public/icons/glyphs-core.svg
/public/icons/glyphs-rest.svg

# Playwright
e2e/.auth/
test-results/
playwright-report/
playwright/.cache/
scripts/tmp-*

# Supabase CLI local cache (not migrations)
supabase/.temp/
.env*

# Capacitor — COMMIT ios/ and android/ (native config, icons, plugin registration), but never
# their build artifacts. The web assets copied into each native project are regenerated by `cap
# sync`, so they're ignored too.
/ios/App/Pods/
/ios/App/App/public/
/ios/App/build/
/ios/App/Podfile.lock
/android/.gradle/
/android/app/build/
/android/build/
/android/app/src/main/assets/public/
/android/local.properties
/android/capacitor-cordova-android-plugins/

# xcodebuild derived data from installing the Capacitor shell on a physical device
# (`-derivedDataPath`). Pure build output — 160MB+ and regenerated on every device build.
/apps/ios/devicebuild/

# Wasp experiment — 414MB / 1,105 untracked files that were never in git and are not part of
# either edition. Un-ignored, they sat one `git add -A` away from the repo (which is precisely why
# that command is banned), and — worse — tsconfig excluded only apps/forum, so 628 of them were in
# the LOCAL tsc program while CI's fresh checkout never saw them. Local and CI were typechecking
# different programs. Ignored here, excluded in tsconfig.json and eslint.config.mjs.
/apps/wasp-pilot/

# Reviewer credential — never in the repo. scripts/qwen-review.mjs reads DASHSCOPE_API_KEY or
# ~/.eno-qwen-key; this line only exists so a stray copy in the working tree cannot be committed.
.eno-qwen-key
*.qwen-key

# Second-opinion receipts — machine-local proof that a given staged diff was reviewed.
# Content-hashed, so they are meaningless on another checkout and must not be shared.
.second-opinion/

# Local Claude Code overrides — machine-specific, never shared
.claude/settings.local.json

# Bulk-enrichment rollback snapshots (scripts/enrich-electronics.ts). Local operational
# artefacts, one per run, and the whole point is that they are recoverable from disk — they are
# not source and must not bloat a PUBLIC repo.
data/enrich-snapshot-*.jsonl
data/cellphones-breadcrumbs.jsonl
data/reclassify-snapshot-*.jsonl
data/repair-snapshot-*.jsonl
data/describe-snapshot-*.jsonl
