# dependencies — unanchored so nested workspaces (apps/*/node_modules) are covered too.
# (The root-only `/node_modules` let apps/forum/node_modules get committed — a 114MB swc
# binary — which GitHub's pre-receive hook rejects. Never commit deps/build artifacts.)
node_modules/
/.pnp
.pnp.*

# next.js — unanchored: also catches apps/*/.next
.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# env & secrets — NEVER commit
.env
.env*.local
.env.production
*.pem
*.key

# local database
/db/*.db
/db/*.db-journal

# logs
*.log
dev.log
server.log

# os / editor
.DS_Store
.vscode/
.idea/

# misc
/coverage
/scratch
/tool-results
/download
/upload

# Azure deployment templates (contain subscription/resource ids)
Deployment-*/
.vercel

# Prisma 7 generated client (regenerated on install/build)
/src/generated/prisma/

# Playwright
e2e/.auth/
test-results/
playwright-report/
playwright/.cache/
scripts/tmp-*
