# dependencies — unanchored so nested workspaces (apps/*/node_modules) are covered too.
# (The root-only `/node_modules` let apps/forum/node_modules get committed — a 114MB swc
# binary — which GitHub's pre-receive hook rejects. Never commit deps/build artifacts.)
node_modules/
/.pnp
.pnp.*

# next.js — unanchored: also catches apps/*/.next
.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# env & secrets — NEVER commit
.env
.env*.local
.env.production
*.pem
*.key

# local database
/db/*.db
/db/*.db-journal

# logs
*.log
dev.log
server.log

# os / editor
.DS_Store
.vscode/
.idea/

# misc
/coverage
/scratch
/tool-results
/download
/upload

# Azure deployment templates (contain subscription/resource ids)
Deployment-*/
.vercel

# Prisma 7 generated client (regenerated on install/build)
/src/generated/prisma/

# Playwright
e2e/.auth/
test-results/
playwright-report/
playwright/.cache/
scripts/tmp-*

# Supabase CLI local cache (not migrations)
supabase/.temp/
.env*

# Capacitor — COMMIT ios/ and android/ (native config, icons, plugin registration), but never
# their build artifacts. The web assets copied into each native project are regenerated by `cap
# sync`, so they're ignored too.
/ios/App/Pods/
/ios/App/App/public/
/ios/App/build/
/ios/App/Podfile.lock
/android/.gradle/
/android/app/build/
/android/build/
/android/app/src/main/assets/public/
/android/local.properties
/android/capacitor-cordova-android-plugins/

# xcodebuild derived data from installing the Capacitor shell on a physical device
# (`-derivedDataPath`). Pure build output — 160MB+ and regenerated on every device build.
/apps/ios/devicebuild/

# Reviewer credential — never in the repo. scripts/qwen-review.mjs reads DASHSCOPE_API_KEY or
# ~/.eno-qwen-key; this line only exists so a stray copy in the working tree cannot be committed.
.eno-qwen-key
*.qwen-key

# Second-opinion receipts — machine-local proof that a given staged diff was reviewed.
# Content-hashed, so they are meaningless on another checkout and must not be shared.
.second-opinion/
