# ── Database (Prisma → Supabase Postgres) ──
# Supabase dashboard → Connect → ORMs → Prisma
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase API (auth + storage) ──
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."   # server-only, never expose

# ── Site + admin ──
# NEXT_PUBLIC_APP_URL="https://eno.vn"
# NEXT_PUBLIC_FORUM_URL="https://eno.forum"  # separate Vercel forum project
# ADMIN_EMAILS="you@example.com"   # comma-separated; gates /admin moderation

# ── Translation (Microsoft Azure AI Translator, free F0 tier = 2M chars/mo) ──
# Azure portal → create "Translator" resource → Keys and Endpoint.
# AZURE_TRANSLATOR_KEY=""
# AZURE_TRANSLATOR_REGION=""   # e.g. southeastasia
# AZURE_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"

# ── Phone OTP delivery (Supabase Send SMS Hook → Zalo ZNS + SMS brandname) ──
# SEND_SMS_HOOK_SECRET=""              # Supabase → Auth → Hooks → Send SMS Hook
# ESMS_API_KEY=""                      # eSMS.vn — ZNS-first + SMS fallback
# ESMS_SECRET_KEY=""
# ESMS_OAID=""                         # verified Zalo Official Account id
# ESMS_ZNS_OTP_TEMPLATE=""             # approved ZNS OTP template id
# ESMS_SMS_BRANDNAME="ENO"
# SPEEDSMS_TOKEN=""                    # SpeedSMS.vn day-1 stopgap (Verify sender)

# ── Gemini ──
# Server-only API-key mode; when set, this takes precedence over Vertex credentials.
# GEMINI_API_KEY=""
# GEMINI_MODEL is fixed in src/lib/gemini.ts as gemini-3.5-flash.

# Cloudflare Turnstile PUBLIC site key (Supabase Auth CAPTCHA). Secret key is set in the Supabase dashboard, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAADvYeXXUeqC3zRQC"

# ── Zalo ZNS (native OTP delivery — no aggregator) ─────────────────────────────
# Setup: verified Zalo OA + app at developers.zalo.me (approved for "send via phone
# number") + ZBS wallet + approved OTP template. Bootstrap the token chain once via
# Zalo API Explorer → put that refresh token in ZALO_INIT_REFRESH_TOKEN; after the
# first send the SINGLE-USE rotating chain lives in Upstash (zalo:oa-tokens) and the
# env value is ignored. ZALO_ZNS_MODE=development delivers only to app/OA admins.
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_ZNS_TEMPLATE_ID=""
ZALO_INIT_REFRESH_TOKEN=""
# ZALO_ZNS_MODE="development"
