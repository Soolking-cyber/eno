[Unit]
Description=eno · re-translate live listings into the nine other languages with Gemma 4 E4B (eno-mt-nightly.py)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/eno/bin/eno-mt-nightly.py --until 07:00
# The model runs in its own container (8 of 12 cores, 7 GB); this keeps the driver itself out of the site's way.
Nice=10
# 01:00 to 07:00 plus the container's start and the last batch's write.
TimeoutStartSec=6h30min
# On stop (or the start timeout) the job stops its model container first, then writes what is done: give it the time.
TimeoutStopSec=300
# The model container is docker's, not this unit's: however the job ended (even SIGKILL), stop it.
# `-`: on most nights the job has already stopped it (--rm removes it), and docker's exit 1 must not mark the night failed.
ExecStopPost=-/usr/bin/docker stop eno-gemma
StandardOutput=append:/var/log/eno-mt-nightly.log
StandardError=append:/var/log/eno-mt-nightly.log
