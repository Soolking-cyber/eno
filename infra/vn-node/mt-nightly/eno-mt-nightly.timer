[Unit]
Description=Nightly listing translation with Gemma 4 E4B on the VN box (01:00 ICT, eno.vn's quietest hours)

[Timer]
# Local time, like every unit here: the box runs Asia/Ho_Chi_Minh. eno.vn's quietest hours are 01:00-08:00 (nginx
# eno-vn.access.log, 2026-11-13: ~1.7k page views/hour at 05:00 against ~15k at 15:00); the job stops itself at 07:00.
# Pinned to Vietnam's clock, whatever the host's timezone: on UTC it would start at 08:00 ICT and refuse every night.
OnCalendar=*-*-* 01:00:00 Asia/Ho_Chi_Minh
Persistent=false

[Install]
WantedBy=timers.target
