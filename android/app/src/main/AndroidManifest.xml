<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- allowBackup=false: remote-server shell — the only local state is the WebView cookie jar,
         and session tokens must not ride cloud backups or D2D transfer to another device. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Portrait-designed UI; Android 16 ignores the lock on large screens, which is fine. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google OAuth deep-link return (enovn://auth-callback). Google blocks OAuth in the
                 embedded WebView, so sign-in opens a Chrome Custom Tab; Supabase redirects back to
                 this scheme, which reopens the app and fires @capacitor/app's appUrlOpen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="enovn" />
            </intent-filter>

            <!-- App Links (verified against https://eno.vn/.well-known/assetlinks.json): open shared
                 content links directly in the app. Deliberately scoped to content paths ONLY —
                 /auth is excluded so App Links can never steal the OAuth callback redirect (that
                 flow returns via enovn://auth-callback through the scheme filter above). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <!-- ⛔ eno.vn, THE APEX, AND NOTHING ELSE (owner, 2026-10-06: "ship both with eno.vn").
                     The app renders the licensed marketplace again, so it claims that domain's links
                     and no other.
                     ⛔ eno.forum and www.eno.forum ARE NOT CLAIMED AND MUST NOT BE (they were from
                     2026-09-08 to 2026-10-06). The forum is the services edition, which this app may
                     not show, and a verified claim would also LOOP: the WebView hands a forum link to
                     the system because allowNavigation excludes it, and the system would route it
                     straight back into this activity.
                     ⛔ www.eno.vn is NOT claimed: its /.well-known/assetlinks.json answers 308 and the
                     Android verifier does not follow redirects; on Android 11 and lower a single
                     unverifiable host fails verification for every host the app claims. A www link
                     that reaches the app another way (enovn://open?url=) still loads, and 308s onto
                     the apex. -->
                <data android:host="eno.vn" />
                <!-- ⚠️ pathPrefix IS A STRING PREFIX, NOT A PATH SEGMENT. Until versionCode 6 this was "/c",
                     which also claimed /checkout, /contact — and /classroom and /concierge. The classroom is
                     WEB-ONLY (owner, 2026-10-29): its links (an invite in Zalo, a report email) must open the
                     browser, where it works, never this app, which only says where it works; the voice
                     guide's window (/concierge) is never a link's target. So: "/c/" for the category pages,
                     and the two other pages the old prefix was kept for, by name. Do not add a short prefix
                     without checking what else starts with it (native-voice-capability.test.ts). -->
                <data android:pathPrefix="/listings" />
                <data android:pathPrefix="/c/" />
                <data android:pathPrefix="/checkout" />
                <data android:pathPrefix="/contact" />
                <data android:pathPrefix="/brands" />
            </intent-filter>

            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @capacitor/camera: taking a photo for a listing. Gallery pick uses the photo picker (no
         storage permission needed on modern Android). Camera is optional hardware. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- navigator.geolocation ("use my location" in search/post): Capacitor's WebChromeClient
         requests BOTH of these at runtime for onGeolocationPermissionsShowPrompt, and Android
         denies a request for any permission the manifest never declared — so without these two
         the browser prompt is auto-refused and locating is permanently dead. Coarse is enough
         for city/ward matching; fine is listed because the runtime request asks for the pair.
         Location is optional hardware (the app works fine with the permission refused). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- The voice guide (owner, 2026-10-29: "also ios android apps add the live concierge to them too"): Capacitor's
         WebChromeClient asks for BOTH of these when the page's getUserMedia wants audio, and denies the whole request
         unless every one is granted (BridgeWebChromeClient) — and Android refuses a runtime request for a permission
         the manifest never declared. Asked only when the person taps Start in the guide's window, after the in-app
         notice naming who hears the voice (src/lib/ai-consent.ts voice_guide). The binary says it can hear with the
         `EnoVoice/1` user-agent token (capacitor.config.ts). A microphone is optional hardware. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
