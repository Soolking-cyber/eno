<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- allowBackup=false: remote-server shell — the only local state is the WebView cookie jar,
         and session tokens must not ride cloud backups or D2D transfer to another device. -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Portrait-designed UI; Android 16 ignores the lock on large screens, which is fine. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google OAuth deep-link return (enovn://auth-callback). Google blocks OAuth in the
                 embedded WebView, so sign-in opens a Chrome Custom Tab; Supabase redirects back to
                 this scheme, which reopens the app and fires @capacitor/app's appUrlOpen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="enovn" />
            </intent-filter>

            <!-- App Links (verified against https://eno.vn/.well-known/assetlinks.json): open shared
                 content links directly in the app. Deliberately scoped to content paths ONLY —
                 /auth is excluded so App Links can never steal the OAuth callback redirect (that
                 flow returns via enovn://auth-callback through the scheme filter above). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <!-- ⛔ THE APP'S OWN DOMAIN. These were eno.vn until 2026-09-08; the app now renders
                     the forum edition, so an eno.vn App Link would have opened the app onto the one
                     origin that carries no Capacitor bridge — and onto the "not yet officially
                     launched" banner. Both hosts are claimed because both answer 200 with no
                     redirect and both serve the same /.well-known/assetlinks.json.
                     ⚠️ www.eno.vn was never verifiable anyway: its assetlinks.json is a 308 and the
                     Android verifier does not follow redirects, so one unreachable host was quietly
                     failing verification for the whole filter. -->
                <data android:host="eno.forum" />
                <data android:host="www.eno.forum" />
                <!-- ⚠️ eno.vn IS STILL CLAIMED, AND THAT IS NOT A LEFTOVER. Every marketplace link
                     ever shared points at eno.vn; dropping these hosts would stop all of them
                     opening the app. The router translates an eno.vn path onto this app's own
                     origin (the forum serves a superset), so the link opens in the app, on the
                     edition that has the Capacitor bridge and no prelaunch banner.
                     ⛔ www.eno.vn is NOT claimed: its /.well-known/assetlinks.json answers 308 and
                     the Android verifier does not follow redirects, so including it would fail
                     verification for every host in this filter. -->
                <data android:host="eno.vn" />
                <!-- ⚠️ pathPrefix IS A STRING PREFIX, NOT A PATH SEGMENT — "/c" also matches
                     /checkout and /contact. Kept because those are first-party pages the app can
                     render anyway, but do not add a short prefix without checking what else starts
                     with it. -->
                <data android:pathPrefix="/listings" />
                <data android:pathPrefix="/c" />
                <data android:pathPrefix="/brands" />
                <!-- The forum-exclusive surfaces, which are the reason the app points here at all.
                     Measured 2026-09-08: 200 on eno.forum, 404 on eno.vn. -->
                <data android:pathPrefix="/vietnam-evisa" />
                <data android:pathPrefix="/itinerary" />
            </intent-filter>

            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- @capacitor/camera: taking a photo for a listing. Gallery pick uses the photo picker (no
         storage permission needed on modern Android). Camera is optional hardware. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- navigator.geolocation ("use my location" in search/post): Capacitor's WebChromeClient
         requests BOTH of these at runtime for onGeolocationPermissionsShowPrompt, and Android
         denies a request for any permission the manifest never declared — so without these two
         the browser prompt is auto-refused and locating is permanently dead. Coarse is enough
         for city/ward matching; fine is listed because the runtime request asks for the pair.
         Location is optional hardware (the app works fine with the permission refused). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
