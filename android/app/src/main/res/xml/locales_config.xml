<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ per-app language picker. Matches the web app's two languages; default resources
     (values/) are Vietnamese, values-en/ carries English. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="vi" />
    <locale android:name="en" />
</locale-config>
