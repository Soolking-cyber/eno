<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark-theme cold start. Full redeclaration of the values/ style because styles do NOT merge
         across resource qualifiers — a partial override would drop the icon and
         postSplashScreenTheme.
         ⛔ THIS FILE IS WHY "REMOVE THE E LOGO" CAN LOOK DONE AND NOT BE. The 2026-09-22 change
         (owner: "initial loading screen should be similar to web remove the e logo there") edited
         values/styles.xml only, so light mode got the blank icon and DARK MODE STILL DREW
         @mipmap/ic_launcher on @color/card — the exact thing that was asked to go, surviving in the
         theme most phones are actually on. The sibling's own comment said to mirror it; the check
         that catches this is `grep -rl windowSplashScreenAnimatedIcon res/`, which lists BOTH.
         Keep in sync with values/styles.xml. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
