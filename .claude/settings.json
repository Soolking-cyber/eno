{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/design-lint.sh\"",
            "timeout": 20,
            "statusMessage": "Checking design canon…"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/ui-strings.sh\"",
            "timeout": 20,
            "statusMessage": "Syncing ui-strings…"
          }
        ]
      }
    ]
  }
}
