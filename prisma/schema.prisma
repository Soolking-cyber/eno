// ENO — Verified marketplace for Vietnamese expats
// Core differentiator: every listing is verification-checked so buyers
// never waste time on fake / wrong-priced posts.

// Prisma 7: the `prisma-client` generator emits an ESM client to an explicit path.
// Runtime connects via a driver adapter (see src/lib/db.ts) — NOT this datasource —
// so the URL lives in prisma.config.ts (used only by the CLI: db push / studio).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  nameVi      String
  slug        String    @unique
  icon        String
  color       String
  description String?
  listings    Listing[]
}

// 1:1 extension of Supabase auth.users — the APP ACCOUNT. id == auth.users.id
// (a uuid; NO @default — supplied by app code in ensureProfile). Every
// authenticated user has exactly one Profile (buyer and/or seller-owner).
// The auth.users FK is added via raw SQL (Prisma can't model the auth schema).
model Profile {
  /// Payments (eno.forum only — see the Order model). Back-relations; nothing on eno.vn reads them.
  ordersBought         Order[]   @relation("OrderBuyer")
  custodyWallet        CustodyWallet?
  id                   String    @id @db.Uuid // = auth.users.id
  email                String?   @unique // mirrored from auth for display/search
  displayName          String? // from OAuth metadata or set later
  avatarUrl            String?
  avatarColor          String    @default("#0a66c2")
  phone                String?   @unique // normalized +84…, mirrored from VERIFIED auth phone
  locale               String?
  accountType          String? // 'individual' | 'business' — null until onboarded (drives the one-time choice)
  businessName         String? // captured at business onboarding; synced to the Seller storefront later
  // ── Trust & Reputation (replaces manual verification) ──
  trustScore           Int       @default(100) // 100 = good standing; never mutate blindly — recompute from TrustEvent
  trustTier            String    @default("standard") // denormalized: restricted | standard | trusted | exceptional
  positiveInteractions Int       @default(0) // track-record gate for the Trusted/Exceptional badge
  falseReportStrikes   Int       @default(0) // anti-abuse: confirmed-false reports filed BY this user
  reportCooldownUntil  DateTime? // anti-abuse: can't file new reports until this passes
  // ── Enforcement ladder (trust Phase 2) — denormalized current state ──
  // scripts/add-enforcement.mjs has run on prod (2026-07), so these are live typed
  // columns now (the deploy-order @ignore markers were dropped in trust Phase 3).
  // Writes still go through src/lib/enforcement.ts only — never mutate directly.
  enforcementState     String    @default("good_standing") // good_standing | warned | throttled | held | suspended
  enforcementUntil     DateTime? // when a timed state (warning / insurance grace) lapses
  goodStandingSince    DateTime? // maintained by recomputeTrust (≥85 sets, <85 clears); insured = ≥180d
  dailyReminderOptIn   Boolean   @default(true) // receive the daily "confirm availability" reminder
  availabilitySkips    Int       @default(0) // consecutive "Skip for now" taps; ≥2 → next review hides Skip (must act). Reset to 0 on confirm.
  weeklyDigestOptIn    Boolean   @default(true) // receive the weekly "top products + moving sales" email digest
  unsubscribeToken     String    @unique @default(cuid()) // tamper-proof one-click email unsubscribe (no login)
  // ── Acquisition attribution (FIRST-touch) — measure CAC per channel ──
  attrSource           String? // 'facebook' | 'google' | 'reddit' | 'direct' | utm_source…
  attrMedium           String? // 'social' | 'cpc' | 'organic' | 'referral' | 'none' | utm_medium…
  attrCampaign         String? // utm_campaign
  attrReferrer         String? // referring hostname on first landing
  attrLandingAt        DateTime? // first-touch timestamp
  // ── ToS acceptance record (E-Transactions Law: keep a tamper-evident record of
  //    click-wrap acceptance). Stamped at onboarding; re-stamped if a user accepts
  //    a newer TOS_VERSION (src/lib/site-legal.ts). ──
  tosAcceptedAt        DateTime?
  tosVersion           String?
  // Presence heartbeat — written at most once per 5 min by getCurrentProfile()'s
  // atomic guarded update (admin.ts), NEVER on the hot getCurrentProfileId path.
  // Nullable on purpose: a never-seen profile must surface NOTHING, not "now".
  // Only the DAY-coarse bucket ever leaves the server (src/lib/last-seen.ts).
  lastSeenAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  seller Seller? // a user MAY own one storefront (FK on Seller.ownerId)
  handle Handle? // public @username (see model Handle)

  buyerConversations      Conversation[]          @relation("BuyerConversations")
  sellerConversations     Conversation[]          @relation("SellerConversations")
  sentMessages            Message[]
  /// Teachers (2026-09-30): one public teacher profile per account. See TeacherProfile.
  teacherProfile          TeacherProfile?
  /// An unfinished teacher profile (2026-10-11) — PRIVATE, see the TeacherDraft model.
  teacherDraft            TeacherDraft?
  /// When this teacher was last emailed about school messages, and their opt-out (2026-10-12).
  teacherMessageEmailState TeacherMessageEmailState?
  teacherMessageEmailThreads TeacherMessageEmailThread[]
  /// Teacher job DMs (owner, 2026-10-20) — src/lib/teachers/job-dms. Relation fields only: no Profile column.
  teacherJobDmConsent     TeacherJobDmConsent?
  teacherJobDms           TeacherJobDm[]
  /// eno Classroom (2026-10-25): the learners this account practises as or for (itself, or its children).
  classroomLearners       ClassroomLearner[]
  teacherJobDmDays        TeacherJobDmDay[]
  /// The cover teachers' Zalo numbers this account (a school) revealed (2026-10-28 — src/lib/teachers/zalo.ts).
  teacherZaloReveals      TeacherZaloReveal[]
  messageReactions        MessageReaction[]
  notifications           Notification[]          @relation("RecipientNotifications")
  trustEvents             TrustEvent[]            @relation("SubjectTrustEvents")
  pushSubscriptions       PushSubscription[]
  nativePushTokens        NativePushToken[]
  savedSearches           SavedSearch[]
  authoredReviews         Review[]                @relation("AuthoredReviews")
  enforcementActions      EnforcementAction[]     @relation("ProfileEnforcementActions")
  forumProfile            ForumProfile?
  forumMemberships        ForumCommunityMember[]
  forumPosts              ForumPost[]             @relation("ForumPostAuthor")
  forumComments           ForumComment[]          @relation("ForumCommentAuthor")
  forumPostVotes          ForumPostVote[]
  forumCommentVotes       ForumCommentVote[]
  forumBookmarks          ForumBookmark[]
  forumSubscriptions      ForumPostSubscription[]
  forumBlocksCreated      ForumUserBlock[]        @relation("ForumBlocker")
  forumBlocksReceived     ForumUserBlock[]        @relation("ForumBlocked")
  forumReportsFiled       ForumReport[]           @relation("ForumReportReporter")
  forumReportsReceived    ForumReport[]           @relation("ForumReportTarget")
  forumModerationReceived ForumModerationAction[] @relation("ForumModerationTarget")
  forumModerationTaken    ForumModerationAction[] @relation("ForumModerationActor")
  forumPostRevisions      ForumPostRevision[]     @relation("ForumPostRevisionEditor")
  forumCommentRevisions   ForumCommentRevision[]  @relation("ForumCommentRevisionEditor")
  itineraries             Itinerary[]
  tripAssistance          TripAssistanceRequest[]

  // ── 2026 e-commerce compliance (Luật TMĐT 122/2025/QH15 · NĐ 248/2026) ──────────────────
  // Full design: docs/compliance-2026.md. Seller identity verification is mandatory from
  // 2027-01-01; these columns are the DENORMALISED CACHE of the live IdentityVerification row.
  //
  // ⚠️ NEVER WRITTEN BY HAND — only by recomputeVerification(), the same discipline as
  // trustTier/trustScore. Read paths may use these; any decision that MATTERS (publishing,
  // takedown, an authority answer) re-reads identity_verifications, because a cache that has
  // drifted is exactly how a lapsed document keeps a verified badge.
  verificationStatus String    @default("unverified") // unverified|pending|verified|rejected|expired|revoked
  verificationTier   String? // 'A' = VNeID (citizens) | 'B' = passport + residence (expats)
  verificationMethod String? // vneid | passport_mrz | passport_manual | business_registry
  verifiedAt         DateTime?
  /// Passport/TRC expiry for Tier B; null for Tier A (a citizen ID does not gate seller status).
  /// Indexed because a nightly job walks it to warn at -30d and expire at 0.
  documentExpiresAt  DateTime?

  /// ⚠️ SEPARATE FROM enforcementState, DELIBERATELY. A trust suspension and a regulatory hold
  /// are different things with different remedies and different audiences; conflating them means
  /// lifting a trust penalty silently lifts a legal hold.
  complianceFlag      String? // authority_hold | identity_fraud | sanctions_review
  complianceFlaggedAt DateTime?

  // ── Verify-on-action nudge tracking (docs/compliance-2026.md §1; account-state.ts) ───────
  // ⚠️ NO `role` COLUMN, DELIBERATELY. "buyer vs seller" looks like an obvious flag and is a trap
  // here: it is not a property a user declares, it is a thing they DO, and it changes the moment
  // someone who joined to buy a scooter decides to sell their sofa. A stored role would be stale
  // exactly when it matters — at the publish attempt — and we would gate on the stale copy.
  // Selling intent is DERIVED instead: `sellingIntentAt` is stamped by the real signals (opening
  // the post wizard, a blocked publish attempt, a saved draft), and `seller != null` answers
  // "has actually sold". Both are facts; a role field would be an assertion.
  /// First observed selling intent. Null = has only ever browsed/bought → nudges stop after day 1.
  sellingIntentAt          DateTime?
  /// Nudge ratchet. ⚠️ The COUNT is the schedule position, not a statistic — shouldNudge() indexes
  /// NUDGE_DAYS with it, so an increment that is not persisted re-sends the same step.
  verificationPromptCount  Int       @default(0)
  lastVerificationPromptAt DateTime?
  /// Independent of weeklyDigestOptIn/dailyReminderOptIn: a user may want product mail and not
  /// compliance nagging, and CAN-SPAM-style hygiene says each stream opts out separately.
  verificationNudgeOptOut  Boolean   @default(false)

  identityVerifications IdentityVerification[]

  // /schools (2026-10-04) — an erased account takes its votes and reviews with it; reports keep the row.
  schoolVotes       SchoolVote[]
  schoolReviews     SchoolReview[]
  schoolEmployments SchoolEmployment[]
  schoolVoteEvents  SchoolVoteEvent[]
  schoolProofKeys   SchoolProofKey[]
  schoolSuggestions SchoolSuggestion[]
  schoolReviewVotes SchoolReviewVote[]
  schoolReports     SchoolReport[]

  @@index([phone])
  @@index([trustTier])
  @@index([attrSource])
  @@index([verificationStatus])
  @@index([documentExpiresAt])
}

/// One row per verification ATTEMPT. APPEND-ONLY: never UPDATE a decided row, never DELETE one —
/// supersede it with a new attempt. The 3-year investigative obligation is precisely about being
/// able to show what we knew and when, and an UPDATE destroys that.
///
/// ⚠️ NO RAW IDENTIFIERS. No CCCD, no passport number, no document image, no raw VNeID assertion.
/// See docs/compliance-2026.md §2.4 — a national ID is low-entropy and structured, so a leaked
/// plain sha256 column is equivalent to leaking the numbers themselves.
model IdentityVerification {
  id        String   @id @default(cuid())
  /// ⚠️ NULLABLE, AND onDelete: SetNull — NOT Cascade (codex). Cascade silently defeated the whole
  /// 3-year retention design: deleting a Profile deleted its verification history, which is exactly
  /// the record we are obliged to keep. Erasure must remove the PERSON, not the evidence that a
  /// verification happened — the row survives pseudonymised (subjectHash is already keyed, and the
  /// name/nationality are cleared by the erasure job), which is what §4.2 describes.
  profileId String?  @db.Uuid
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  tier         String // 'A' | 'B'
  method       String
  status       String // pending | verified | rejected | expired | revoked
  submittedAt  DateTime  @default(now())
  decidedAt    DateTime?
  decidedBy    String? // admin profile id, or 'system' for auto-approval
  rejectReason String? // mrz_unreadable | checksum_failed | expired | name_mismatch | manual

  /// HMAC-SHA256 of the issuer's subject identifier, keyed by IDENTITY_HASH_PEPPER (Secret
  /// Manager, both stores). Detects "same human, second account" without holding the identifier.
  subjectHash String @db.Char(64)

  fullName          String?
  nationality       String?   @db.Char(3) // ISO-3166-1 alpha-3, straight from the MRZ
  /// ⛔ WHERE THE PERSON LIVES, WHICH IS NOT WHAT THE PASSPORT SAYS — and the settlement rules turn
  /// on it, not on nationality. Populated ONLY from a source that actually verified an address:
  /// today that means the payment provider's own KYC (Crossmint runs KYC/AML natively and is the
  /// regulated party for it). Our own document capture can establish VIETNAMESE residence — a VNeID
  /// or a TRC is a residence document — and deliberately cannot establish a foreign one.
  /// ⚠️ NULL MEANS UNKNOWN, AND UNKNOWN IS TREATED AS VIETNAM by payments/eligibility.ts. So an
  /// unpopulated column is safe and merely means the wallet rail stays closed for that user.
  residenceCountry  String?   @db.Char(3)
  /// ⛔ WHO SAID SO — and the country above is IGNORED unless this names an address-verifying
  /// source. See ADDRESS_VERIFYING_SOURCES in src/lib/kyc/identity.ts, which is the allow-list.
  /// Without it the first writer of `residenceCountry` — a form field, a CSV backfill — silently
  /// becomes the law deciding who may hold a stablecoin wallet. Only value today: provider_kyc.
  /// ⚠️ `residence_document` WAS CONSIDERED AND REJECTED — a Vietnamese residence document already
  /// forces VNM before the column is consulted, so that label could only ever have arrived on a
  /// document that is NOT one. Do not add it back.
  residenceSource   String?
  birthYear         Int? // year only — day/month is not needed for an age gate
  documentType      String? // passport | trc | visa | cccd
  documentExpiresAt DateTime?
  assuranceLevel    String?

  /// Provider evidence: assertion id, OCR confidence, reviewer note. NEVER the document itself.
  evidence Json?

  // ── The declarant's own attestation (owner, 2026-08-03) ─────────────────────────────────
  // Before submitting, the user declares the documents are genuine and theirs, the information is
  // true, and legal responsibility for a false declaration is theirs. src/lib/compliance/declaration.ts
  //
  // ⚠️ THE HASH IS WHAT MAKES THIS WORTH ANYTHING. A boolean "accepted terms" proves only that a
  // box was ticked; it cannot show WHICH WORDS were on screen. Storing the version plus a digest of
  // the exact published text means the affirmation can be reproduced and checked years later — by
  // us, by an auditor, or by the user disputing it. Unkeyed on purpose: anyone must be able to
  // recompute it from the published wording.
  /// Null on records created before the declaration existed — absent is NOT the same as refused.
  declarationVersion String?
  declarationHash    String?   @db.Char(64)
  declaredAt         DateTime?
  /// cf-connecting-ip only. A client-supplied X-Forwarded-For in a legal record is worse than none.
  declarationIp      String?

  /// Set once the stored document objects have actually been deleted (§4.3). ⚠️ Written AFTER the
  /// storage delete succeeds, never before — a purge flag written ahead of the delete is how
  /// documents survive a retention policy everyone believes is working.
  documentsPurgedAt DateTime?

  supersedesId String?               @unique
  supersedes   IdentityVerification? @relation("Supersedes", fields: [supersedesId], references: [id])
  supersededBy IdentityVerification? @relation("Supersedes")

  @@index([profileId, status])
  @@index([subjectHash])
  @@index([status, documentExpiresAt])
  @@map("identity_verifications")
}

/// An authority-issued or admin-issued takedown. Retained 3 years; never deleted while an appeal
/// is open. Separate from the Report/EnforcementAction flow: those are OUR judgement, this is
/// someone else's order and the distinction is the whole intermediary position.
model TakedownOrder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// ⚠️ NO `listingId` SCALAR HERE (agy). The relation is driven by Listing.takedownOrderId, so a
  /// scalar on this side was a dangling column that nothing wrote and nothing read — while LOOKING
  /// authoritative to the next person who queried it. One order can cover several listings.
  listings Listing[] @relation("ListingTakedown")
  sellerId String? // whole-storefront orders

  action         String // unpublish | restore | restrict
  reason         String // visa_scam | illegal_sublet | counterfeit | prohibited_goods | …
  /// ⚠️ A KEY INTO LEGAL_BASIS, NEVER FREE TEXT. An authority-supplied string would otherwise be
  /// quoted verbatim in an email we send under our own name.
  legalBasis     String
  /// The authority's own document number, e.g. "QĐ-1234/2026".
  orderReference String?
  issuedBy       String?
  issuedAt       DateTime?

  /// Which API key acted. Null for an in-app admin action (actor is then in the audit row).
  actorKeyId   String?
  actorAdminId String?

  appealUntil   DateTime?
  appealedAt    DateTime?
  appealOutcome String? // upheld | overturned | withdrawn

  @@index([sellerId])
  @@index([createdAt])
  @@map("takedown_orders")
}

/// APPEND-ONLY, HASH-CHAINED investigative log (3-year retention).
///
/// ⚠️ A PLAIN TABLE PROVES NOTHING — anyone with write access can rewrite history, so it is
/// worthless as evidence. Each row commits to its predecessor (rowHash = H(prevHash ‖ row)), so a
/// single edit breaks the chain from that row onward and is detectable. UPDATE/DELETE are also
/// blocked by RULEs in the DDL script, because "we never update it" is a convention and a rushed
/// psql session is not bound by conventions.
model ComplianceAudit {
  id         BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now())

  actorType String // user | admin | authority | system
  actorId   String?
  /// ⚠️ cf-connecting-ip ONLY. A client-supplied X-Forwarded-For in an evidence log is worse than
  /// no IP at all, because it looks authoritative.
  actorIp   String?

  action      String // identity.verified | listing.taken_down | listing.restored | …
  subjectType String // profile | listing | seller
  subjectId   String

  /// Already redacted at write time. NEVER a document image, raw identifier, or full assertion —
  /// this table is retained for 3 years and must survive a data-protection audit too.
  detail Json

  legalBasis String?
  prevHash   String? @db.Char(64)
  rowHash    String  @db.Char(64)

  @@index([subjectType, subjectId, occurredAt])
  @@index([action, occurredAt])
  @@map("compliance_audit")
}

// Brand catalogue (product categories only). Grows automatically: a brand read by
// the AI or typed by a seller is normalized + typo-deduped against existing entries
// (so "huawi" merges into "huawei", recorded as an alias) before a new row is added.
// `iconSlug` maps to a simple-icons monotone logo when recognized, else a monogram.
model Brand {
  id           String    @id @default(cuid())
  slug         String    @unique // url/canonical slug, e.g. "huawei"
  name         String // display name, e.g. "Huawei"
  normalized   String    @unique // matching key: lowercased, de-accented, alphanumeric only
  aliases      String    @default("[]") // JSON array of normalized variants/typos merged into this brand
  iconSlug     String? // simple-icons slug if recognized; null → monogram fallback
  logoPath     String? // admin-curated monotone SVG path (24x24); overrides iconSlug
  listingCount Int       @default(0) // ranks the brand directory
  status       String    @default("active") // active | hidden (admin can hide junk)
  createdAt    DateTime  @default(now())
  curatedAt    DateTime? // when an admin last reviewed/curated this brand

  @@index([status, listingCount])
}

// A buyer's saved search (their filter set) — alerts them (in-app + web push) when
// a new matching listing appears. FK within public → Profile (normal flow).
model SavedSearch {
  id             String   @id @default(cuid())
  profileId      String   @db.Uuid
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label          String // human-readable summary of the filters
  params         String // JSON of SavedSearchParams (category/subcategory/type/price/q/district/attrs)
  notify         Boolean  @default(true) // alert on new matches
  lastNotifiedAt DateTime @default(now()) // only listings created after this trigger an alert
  createdAt      DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([notify])
}

// Web Push subscription (one row per browser/device that opted in). FK within
// public → Profile, so it goes through the normal drop-FK→push→re-add flow.
model PushSubscription {
  id        String   @id @default(cuid())
  /// ⚠️ NULLABLE, AND onDelete: SetNull — NOT Cascade (codex). Cascade silently defeated the whole
  /// 3-year retention design: deleting a Profile deleted its verification history, which is exactly
  /// the record we are obliged to keep. Erasure must remove the PERSON, not the evidence that a
  /// verification happened — the row survives pseudonymised (subjectHash is already keyed, and the
  /// name/nationality are cleared by the erasure job), which is what §4.2 describes.
  profileId String?  @db.Uuid
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([profileId])
}

// Native (Capacitor) push tokens — FCM (Android) / APNs (iOS) device tokens, separate from the
// web-push PushSubscription above. One row per device token; sends fan out via src/lib/native-push.
model NativePushToken {
  id        String   @id @default(cuid())
  /// ⚠️ NULLABLE, AND onDelete: SetNull — NOT Cascade (codex). Cascade silently defeated the whole
  /// 3-year retention design: deleting a Profile deleted its verification history, which is exactly
  /// the record we are obliged to keep. Erasure must remove the PERSON, not the evidence that a
  /// verification happened — the row survives pseudonymised (subjectHash is already keyed, and the
  /// name/nationality are cleared by the erasure job), which is what §4.2 describes.
  profileId String?  @db.Uuid
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  token     String   @unique
  platform  String // 'ios' | 'android'
  createdAt DateTime @default(now())

  @@index([profileId])
}

model Seller {
  id                       String               @id @default(cuid())
  // Link to the owning account. NULL = legacy/guest seller (no account yet).
  ownerId                  String?              @unique @db.Uuid // one Profile owns at most one Seller (1:0..1)
  owner                    Profile?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  claimedAt                DateTime? // when a real account claimed this guest seller
  avatarUrl                String?
  name                     String
  avatarColor              String               @default("#dc2626")
  /// Payments (eno.forum only). Money settles to a storefront, not to a person.
  orders                   Order[]
  rating                   Float                @default(5)
  reviewCount              Int                  @default(0)
  verified                 Boolean              @default(false)
  verifiedSeller           Boolean              @default(false)
  // ⚠️ A COMMERCIAL RELATIONSHIP, NOT A VERIFICATION, AND NOT A TRUST SCORE. eno created this
  // account itself for a company it has an agreement with (the first is VietKite, a licensed VN
  // travel/visa company). It is deliberately NOT `verified`/`verifiedSeller` — those mean "eno
  // checked a document" and are earned per-seller — and it is NOT a trustTier, which is computed
  // from behaviour. Overloading either would corrupt a meaning that other code already reads.
  //
  // ⚠️ IT CHANGES BEHAVIOUR, NOT JUST DECORATION: an official partner shares NO phone number, and
  // that rule is enforced in phoneForSeller() (src/lib/contact.ts), the single source of truth for
  // seller contact — NOT in the reveal route alone. Putting it in the helper is what makes the rule
  // survive a future caller; the route-only version held only because VietKite's phone column
  // happened to be NULL, which any profile edit would silently have undone.
  //
  // ⚠️ SET BY eno ONLY. There is no seller-facing write path: updateSeller() builds its `data`
  // object field-by-field from an allowlist (verified 2026-08-10, no `...body` spread anywhere),
  // so this column is unreachable from PATCH /api/profile. Keep it that way — if that function
  // ever grows a spread, a seller can grant themselves the badge and switch off their own phone.
  officialPartner          Boolean              @default(false)
  /// OPTIONAL STOREFRONT COVER — a wide banner across the top of this shop's page.
  /// Null for every storefront that has not set one, and null is the normal case: the page
  /// renders exactly as it does today without it, so nothing depends on it existing.
  /// ⚠️ NOT WATERMARKED. It is the seller's own artwork, like the avatar — see
  /// scripts/set-partner-avatar.ts for why the eno mark stays on listing photos only.
  bannerUrl                String?
  /// The narrow creative for phones. Partners ship two: a wide web banner (VinWonders' is
  /// 1280x300, 4.3:1) and a much squarer mobile one (366x188, 1.9:1) whose artwork and text are
  /// laid out for that shape. Cropping the wide one to a phone cuts the wordmark and the CTA off,
  /// so this is art direction, not a resolution switch.
  /// ⚠️ NULL FALLS BACK TO `bannerUrl`, which is the correct behaviour for a shop that uploaded
  /// only one image — never render nothing just because the mobile variant is missing.
  bannerMobileUrl          String?
  /// PARTNER CHECKOUT DISCOUNT — shown on every affiliate listing of this seller. Partner-wide
  /// rather than per-listing because one code covers the whole catalogue; repeating it on each
  /// listing is 17 chances for them to drift apart.
  /// ⚠️ THE CODE IS REDEEMED ON THE PARTNER'S SITE, NOT HERE. eno never validates it, never
  /// discounts anything, and must not imply it does — the copy says where to type it.
  affiliateDiscountCode    String?
  affiliateDiscountPercent Int?
  // Mirror of the owner Profile's trust (denormalized so a storefront card/badge
  // renders without a Profile join; recomputed whenever the owner's score changes).
  trustScore               Int                  @default(100)
  trustTier                String               @default("standard") // restricted | standard | trusted | exceptional
  memberSince              DateTime             @default(now())
  responseRate             Int                  @default(100)
  responseTime             String               @default("within an hour")
  // Set ONLY by recomputeResponseRates() (nightly SQL, >=5-convo sample) — its presence
  // is what separates a MEASURED responseRate from the fabricated =100 default above.
  // Display (responseBucket) and trust (responseQ) both gate on it; never write it
  // anywhere else or the honesty gate is laundered.
  responseMetricAt         DateTime?
  location                 String?
  bio                      String?
  phone                    String?              @unique // KEEP: the guest-claim join key
  // ── Seller legal identity (Đ.29 ND52 + Law 122/2025 collection duty; VNeID
  //    verification enforceable 1 Jan 2027). Provided to buyers on request and to
  //    authorities — idNumber/taxCode must NEVER appear in public serializations (serialize.ts).
  //    ⚠️ Since 2026-10-01 a BUSINESS seller's legalName (+ legalAddress/taxCode for a company) CAN be
  //    displayed in the "Seller information" block, read server-side off the raw row — not serialized —
  //    but only once SELLER_INFO_NOTICE_SINCE is set and only for an identity saved on/after it
  //    (identityUpdatedAt; src/lib/seller-info.ts). idNumber is never displayed. ──
  legalName                String? // full legal name (individual) or registered company name
  legalAddress             String? // residence (individual) / head office (business)
  idNumber                 String? // CCCD (individual) or ERC number (business)
  taxCode                  String? // mã số thuế, if any
  identityUpdatedAt        DateTime? // when the seller last edited these fields
  // ── VietQR/GDT tax-code soft check (owner "go" 2026-07-23) — FACTS only; the
  //    "verified" verdict is DERIVED at read time (src/lib/tax-lookup.ts) so a later
  //    legalName edit can never serve a stale badge. Written ATOMICALLY with taxCode
  //    in the same UPDATE (core/seller.ts) — facts always describe the row's own code.
  //    null taxCheckedAt = never checked / transient failure (self-heals next save);
  //    taxActive=false + checkedAt set = the registry POSITIVELY didn't know the code.
  taxCheckedAt             DateTime?
  taxRegisteredName        String? // registered name GDT returned (public record)
  taxActive                Boolean? // 'NNT đang hoạt động' at check time
  // ── Business VERIFICATION badge (owner 2026-07-23: one badge, ≥2 channels). ──
  //    The badge is IDENTITY-HASH-DERIVED, never a plain latched flag (external
  //    review — kills the approval-vs-edit race, the indefinite latch, and stale
  //    evidence). At an admin approval we stamp the identity hash that was frozen at
  //    submit; the public badge renders ONLY when this hash still equals a live hash
  //    of the seller's CURRENT identity (any legal-name/tax/id/address/display-name
  //    edit changes the live hash → badge silently stops matching, no reset write) AND
  //    verifiedUntil > now AND taxVerdict()==='verified'. verifiedIdentityHash null =
  //    never verified. See src/lib/business-verification.ts (sellerIdentityHash).
  verifiedIdentityHash     String? // sha256 of the identity approved; compared to the live one
  verifiedAt               DateTime? // when the approving review landed
  verifiedUntil            DateTime? // reviewedAt + 365d — the badge expires, never indefinite
  verifiedBy               String? // admin email that approved (audit)
  verifications            SellerVerification[]
  listings                 Listing[]
  reviews                  Review[]
  conversations            Conversation[]
  apiKeys                  ApiKey[]
  webhooks                 WebhookEndpoint[]
  handle                   Handle? // public @shopname (see model Handle)

  payout                   SellerPayout? // VietQR bank details — a SEPARATE table, see the model

  @@index([ownerId])

  school  School? // /schools: the school this shop is linked to, if any (one-to-one: School.sellerId is unique)
}

/// WHERE A VIETNAMESE BUYER'S MONEY ACTUALLY LANDS.
///
/// ⛔ ITS OWN TABLE, AND THAT IS THE WHOLE POINT. These three columns lived on `Seller` for exactly
/// one review round. A reviewer put it plainly: Seller is the most-queried model in the app, ~16 of
/// its queries have no explicit `select`, and Prisma returns every scalar — so a bank account number
/// would be one `{...seller}` away from a public response forever. It was not leaking (measured:
/// `serializeListing` and the account route both pick fields), which is precisely why it was worth
/// moving before it did. A relation has to be explicitly `include`d; a column rides along for free.
///
/// ⛔ NOT `Seller.bankNameSeen`, which is a reviewer's audit note of what they read off a
/// verification document. That is evidence about a past check; this is live payment instruction, and
/// conflating them would let an unverified string decide where money goes.
///
/// ⚠️ SENSITIVE UNDER PDPL DECREE 13/2023 — never log it, never put it on a public profile. It
/// reaches a buyer only inside the QR payload of an order they are actually paying.
model SellerPayout {
  sellerId String @id
  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// The 6-digit NAPAS acquirer BIN, e.g. 970415 for VietinBank.
  bankBin         String  @db.VarChar(6)
  bankAccountNo   String  @db.VarChar(19)
  /// The holder's name as the bank has it — shown for confirmation before the buyer sends.
  bankAccountName String

  updatedAt DateTime @updatedAt

  @@map("seller_payout")
}

// A single business-verification CASE — immutable once submitted, versioned so a
// rejected seller resubmits as a new row (external review: freeze the evidence a
// reviewer decides on). Channel 1 (tax/registry) is derived live from the Seller;
// this record is Channel 2 — the human review of the uploaded identity + bank docs.
// ⚠️ documents hold PRIVATE-BUCKET PATHS ONLY (never a public URL); reachable solely
// through short-lived admin-gated signed URLs. Deleted after the decision + a dispute
// window (retentionUntil) — PDPL data-minimization, these are review artifacts.
model SellerVerification {
  id             String    @id @default(cuid())
  sellerId       String
  seller         Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  version        Int       @default(1) // (sellerId, version) unique — resubmission = new version
  status         String    @default("draft") // draft | pending | approved | rejected
  // The identity FROZEN at submit — sha256(legalName|taxCode|idNumber|legalAddress|name).
  // The approval writes this onto Seller.verifiedIdentityHash; the badge only shows while
  // it still matches the live identity, so an edit-after-approval silently drops the badge.
  identityHash   String?
  // [{ kind: 'identity'|'bank'|'authorization', path, mime, sha256, uploadedAt }] — private
  // bucket paths, magic-byte-validated at upload. Frozen when status leaves 'draft'.
  documents      Json      @default("[]")
  bankNameSeen   String? // holder name the reviewer read off the bank doc (audit trail)
  consentAt      DateTime? // explicit upload consent (PDPL Decree 13/2023) — logged
  consentVersion String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedBy     String? // admin email
  note           String? // rejection reason / reviewer note (EN, operator-facing)
  retentionUntil DateTime? // after this, a job removes the bucket objects for this case
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sellerId, version])
  @@index([status])
  @@index([sellerId])
}

// ── Public @handles (Telegram-style usernames) ──────────────────────────────────
// ONE global namespace for users AND storefronts: the handle is the PRIMARY KEY,
// so uniqueness across both owner kinds is a DB guarantee (no cross-table races).
// A row belongs to EXACTLY ONE of profileId / sellerId (enforced in src/lib/handle.ts;
// Prisma can't express XOR — a DB CHECK (handle_owner_xor) is applied by
// scripts/unique-constraints.mjs in the db:setup chain). Rows CASCADE with their owner, so deleting an account
// or storefront frees the name. Canonical form: ^[a-z][a-z0-9_]{2,29}$ (lowercased
// on claim). Public URL: eno.vn/<handle> — clean, no "@" (src/app/[handle]/page.tsx).
model Handle {
  handle    String   @id
  profileId String?  @unique @db.Uuid
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sellerId  String?  @unique
  seller    Seller?  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Partner-API credential (Phase 1). A key acts FOR one shop (Seller); the owning
// account (profileId) is recorded for audit. Only the sha256 HASH is stored — the secret
// is shown once at mint. `prefix` is the safe display fragment (e.g. "eno_live_ab12cd").
// `scopes` is space-separated (listings:read, analytics:read, …). Revoke = set revokedAt.
model ApiKey {
  id         String    @id @default(cuid())
  sellerId   String
  seller     Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  profileId  String    @db.Uuid // owning account (audit; FK omitted — scoping is by seller)
  name       String
  prefix     String    @unique
  hashedKey  String    @unique
  scopes     String    @default("listings:read analytics:read")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([sellerId])
}

// Partner webhook endpoint (Phase 3). A shop registers a URL to receive signed listing
// events (listing.created/updated/sold/deleted). `secret` signs deliveries (Standard-
// Webhooks HMAC). Auto-disabled after repeated failures (failureCount); re-enable by
// re-registering. URL is SSRF-validated at registration.
model WebhookEndpoint {
  id             String    @id @default(cuid())
  sellerId       String
  seller         Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  url            String
  secret         String // whsec_… used for HMAC signatures
  events         String    @default("*") // space-separated event names, or "*" for all
  enabled        Boolean   @default(true)
  failureCount   Int       @default(0)
  lastError      String?
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([sellerId])
}

// Per-listing daily snapshot (Phase 3). Written once a day by the cron from the listing's
// cumulative views/contactCount, so the analytics endpoint can return a time series + day
// deltas. One row per (listing, day).
model ListingDailyStat {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int
  leads     Int
  createdAt DateTime @default(now())

  @@unique([listingId, day])
  // (No separate listingId index: the unique key above leads with listingId and serves those reads. Dropped
  // 2026-10-17 by scripts/listing-index-diet-ddl.mjs.)
}

model Review {
  id              String   @id @default(cuid())
  sellerId        String
  seller          Seller   @relation(fields: [sellerId], references: [id])
  author          String
  rating          Int      @default(5)
  text            String
  // ── Verified-buyer provenance (all NULLABLE — seeded/legacy rows have none and
  // render WITHOUT the "Verified buyer" badge). A real review is created only from
  // a conversation whose listing sold / offer was accepted (api/sellers/[id]/reviews).
  authorProfileId String?  @db.Uuid
  authorProfile   Profile? @relation("AuthoredReviews", fields: [authorProfileId], references: [id], onDelete: SetNull)
  listingId       String?
  listing         Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // One review per conversation — perfect dedup + the verified-buyer proof.
  conversationId  String?  @unique
  createdAt       DateTime @default(now())

  @@index([sellerId])
  @@index([authorProfileId])
}

model Listing {
  /// Payments (eno.forum only). Restrict on the FK: an order outlives a hidden or sold listing.
  orders                  Order[]
  id                      String             @id @default(cuid())
  title                   String
  titleVi                 String?
  description             String
  /// Vietnamese description, mirroring `titleVi`. Null on everything a human posted in one
  /// language; set by the feed importer, which keeps the merchant's original here and puts the
  /// English translation in `description`.
  /// ⚠️ ListingDescription already had the slot for this — it was calling useLocalized(text,
  /// null, i18n), passing null exactly where titleVi goes for the heading.
  descriptionVi           String?
  price                   Float
  priceUnit               String             @default("VND")
  currency                String             @default("₫")
  // Price is open to offers. Default TRUE (Vietnamese haggling norm + preserves the
  // pre-2026-07-07 "offers work everywhere" behavior). Sellers opt into a FIXED price
  // in the post wizard → the offer UI is hidden and offer POSTs are rejected server-side.
  negotiable              Boolean            @default(true)
  // ── Price drop (anti-fake-discount, 2026-07-07) ──────────────────────────────
  // The struck-through "was" anchor. SERVER-COMPUTED ONLY: the lowest price the
  // listing was offered at in the trailing 30 days (EU-Omnibus-style reference,
  // from the PriceChange audit) — never seller-entered, so raise-then-drop can't
  // fake a discount. null = no active badge. Cleared instantly on any price raise.
  previousPrice           Float?
  /// PARTNER AFFILIATE LINK — set ONLY on listings whose checkout happens on a partner's own
  /// site (VinWonders attraction tickets, 2026-08-24). When present the PDP swaps its on-platform
  /// contact/chat CTA for an outbound "Book on <partner>" button, because there is no eno seller
  /// to message: the buyer pays the partner, not us.
  /// ⚠️ NULL FOR EVERY ORDINARY LISTING, and that is the whole feature flag. Nothing about the
  /// normal marketplace path changes; `affiliateUrl == null` is the existing behaviour verbatim.
  /// ⚠️ THE OUTBOUND ANCHOR MUST CARRY rel="sponsored" — Google treats an undisclosed paid link as
  /// a link-scheme violation, which costs the ranking this feature exists to earn.
  affiliateUrl            String?
  /// PER-PRODUCT checkout discount, which is the shape the partner actually uses: measured across
  /// the VinWonders catalogue 2026-08-24 the codes differ per attraction (MEMBER10, MEMBER3,
  /// MEMBER2, SHOW5) and three products have none at all. A partner-wide code alone was the wrong
  /// model — it would have shown the same 10% on a park whose real code gives 2%.
  /// ⚠️ NULL FALLS BACK to Seller.affiliateDiscountCode. Null here means "no product-specific
  /// code", not "no discount".
  affiliateDiscountCode    String?
  affiliateDiscountPercent Int?
  priceDropAt             DateTime? // badge clock — the drop badge shows for 7 days from here
  // Monotonic notification ratchet (Poshmark model): the lowest price buyers were
  // ever notified at. A new drop notification requires ≥10% below this. NEVER reset
  // upward (not even by raises), so cycling can't re-farm notifications.
  lowestNotifiedPrice     Float?
  priceDropNotifiedAt     DateTime? // max 1 drop notification per listing per 24h (DB-enforced)
  // ── Urgent sale "Bán gấp" (2026-07-07) ───────────────────────────────────────
  // Active while > now (read-time check — no cron). A PAST value is kept as history:
  // it anchors the 7-day re-arm cooldown (early switch-off sets it to now), so
  // off/on cycling can't keep a listing permanently urgent. null = never urgent.
  urgentUntil             DateTime?
  priceChanges            PriceChange[]
  location                String
  district                String?
  city                    String
  lat                     Float?
  lng                     Float?
  condition               String?
  images                  String
  // Optional single listing video (≤60s) — public URL in the `listing-videos` bucket. Autoplays
  // muted on card hover + powers the TikTok-style Video view. Additive raw column (no FK).
  video                   String?
  categoryId              String
  category                Category           @relation(fields: [categoryId], references: [id])
  // Subcategory is an explicit slug from the canonical taxonomy (src/lib/taxonomy.ts),
  // chosen at post time (keyword auto-suggested). Reliable filtering + accurate facets.
  subcategorySlug         String?
  // Intent axis, separate from the category: sell | rent | wanted | free | service | job | event.
  // A motorbike lives in Vehicles whether rented or sold. Defaults to 'sell'.
  listingType             String             @default("sell")
  // Canonical Brand.slug (product categories only) — typo-deduped at post time.
  brandSlug               String?
  // Specific model within the brand (e.g. "iPhone 14 Pro", "Sorento"). Display
  // string; the brand rail groups distinct models present in the catalogue.
  model                   String?
  sellerId                String
  seller                  Seller             @relation(fields: [sellerId], references: [id])
  // Denormalized mirror of the seller's effective trust score (Seller.trustScore),
  // synced on listing create + every trust recompute (src/lib/trust.ts). Lets the feed
  // ORDER BY a LOCAL indexed column instead of joining Seller + external-sorting on
  // every query (the hot read-path scaling fix). Card display still reads the joined
  // seller; this column is purely the ranking key.
  sellerTrustScore        Int                @default(100)
  // Balanced feed ranking key (src/lib/ranking.ts): a BOUNDED blend of seller trust +
  // recency (+ featured) — NOT trust alone, so a trusted business gets a real edge without
  // burying fresher/more-relevant listings. Recomputed on create/bump, on a seller's trust
  // change, and by the daily cron (recency decay). The default "Recommended" feed sorts by
  // this; search blends it with query relevance. Backfill on migrate or it sorts last.
  rankScore               Float              @default(0)
  // ── Ranking transparency (Luật TMĐT 122/2025/QH15) ─────────────────────────────────────
  // ⚠️ THE COMPOSITE ALONE IS NOT AUDITABLE. Disclosing that trust is 60% of browse rank is a
  // legal statement, and we must be able to SHOW why one listing outranked another — to a
  // regulator, and to the seller who asks. A bare rankScore cannot answer that, and cannot be
  // recomputed after the fact because the inputs (trust, demand, age) have all moved since.
  // So the components are persisted alongside it, with the formula version that produced them.
  // ⚠️ Bump rankFormulaVersion whenever the RANK constants change, or old rows silently claim
  // to have been scored by the current formula. See docs/compliance-2026.md §2.3.
  rankTrustComponent      Float?
  rankDemandComponent     Float?
  rankRecencyComponent    Float?
  rankFormulaVersion      String?
  rankComputedAt          DateTime?
  // ── Compliance lifecycle ───────────────────────────────────────────────────────────────
  // ⚠️ SEPARATE FROM `status`. A listing removed by authority order is NOT "sold" and must not
  // render the sold page (which deliberately returns 200 + noindex) — that would tell buyers the
  // item sold, which is false. A takedown is its own terminal state and returns 410 + noindex.
  complianceStatus        String             @default("clear") // clear | under_review | taken_down | restored
  takenDownAt             DateTime?
  takedownOrderId         String?
  takedownOrder           TakedownOrder?     @relation("ListingTakedown", fields: [takedownOrderId], references: [id])
  // Partner's own id for this listing (Partner API sync/upsert). Unique PER seller so two
  // shops can each use "sku-1". NULL for listings not created via the sync endpoint.
  externalId              String?
  /// The BUILDING (project) this unit belongs to, e.g. `masteri-thao-dien`. Set by the Rever
  /// import from the listing page's own BreadcrumbList JSON-LD; NULL on everything else, which
  /// reads as "not part of a known building" and keeps every ordinary listing on its own pin.
  /// ⛔ NOT KEYED ON (lat,lng), DELIBERATELY. Rever geocodes the PROJECT, so 1,100 units share 31
  /// coordinates — but a shared point is NOT a shared building: other projects sit on the same
  /// geocode, and any user listing dropped there would silently join the group. Both plan
  /// reviewers rejected coordinate-keying independently.
  /// Added additively by scripts/building-key-ddl.mjs — never via `prisma db push`.
  buildingKey             String?
  verified                Boolean            @default(false)
  /// IDENTITY HOLD — the seller identity gate (src/lib/compliance/seller-publish-gate.ts) parked this
  /// listing instead of publishing it: an admin approved/activated it, an enforcement lift restored
  /// it, scripts/publish-held.ts ran, or its guest storefront was claimed — while the owner could
  /// not yet publish (IDENTITY_GATE_ENFORCED on, unverified past their deadline). `verified` stays
  /// false; when the owner becomes verified, releaseIdentityHolds() flips both back in one write.
  /// ⛔ EVERY TAKEDOWN (verified:false as a moderation act) MUST ALSO WRITE identityHold:false, or
  /// verifying would republish a listing a moderator pulled. Always false while the gate is off.
  /// Added additively by scripts/listing-identity-hold-ddl.mjs — never via `prisma db push`.
  identityHold            Boolean            @default(false)
  /// THE TEACHER CARD'S "IDENTITY VERIFIED" TICK — a DISPLAY CACHE, never a fact: the IDENTITY_MARK_NOTICE_VERSION under
  /// which src/lib/teachers/identity-mark-card.ts last computed the mark SHOWN for this (teacher) listing; NULL = not
  /// shown. The truth is TeacherProfile.identityMark* plus identity_verifications, and every writer of either re-derives
  /// this — and the clock, which no writer moves (a document lapses at 00:00 ICT), by the card pass at 00:05 ICT
  /// (/api/cron/identity-marks). The card shows the tick only while the cached version is today's constant, so a notice
  /// bump hides every older grant at once, with no data migration.
  /// ⛔ ONLY identity-mark-card.ts WRITES A NON-NULL VALUE (src/lib/compliance/public-state-writes.test.ts MARK_WRITERS),
  /// by raw SQL so Listing.updatedAt never moves (a display cache is not an edit); a scrub clears it with the person's
  /// other content (listing-tombstone.ts PERSONAL_SCRUB_DATA). It never leaves the server except as a card's
  /// `identityMark: true` — never the version, never a reason.
  /// Added additively by scripts/listing-identity-mark-ddl.mjs — never via `prisma db push`.
  identityMarkNotice      String?
  verificationMethod      String?
  verifiedAt              DateTime?
  verifiedBy              String?
  verificationNotes       String?
  searchText              String             @default("") // folded EN+VI blob for accent-insensitive search
  /// MULTI-VALUED facets, `|key:value|key:value|` — the sizes one product is sold in, the sports it
  /// belongs to. `attributes` answers one value per facet and cannot hold eight shoe sizes.
  /// ⛔ NO PUBLIC WRITE PATH REACHES THIS COLUMN, AND THAT IS THE POINT: browse matches it with a
  /// `contains`, so a seller-typed value containing `|size:m|` would otherwise filter as a size.
  /// `sanitizeAttributes()` does not know this field exists; only importers write it, via Prisma.
  /// Format + helpers in src/lib/facet-tokens.ts. Additive raw column (nullable, no FK) applied by
  /// scripts/facet-tokens-col.mjs — same class as marketPosition/video.
  facetTokens             String?
  // Availability (separate from `verified` moderation): 'active' is live,
  // 'sold'/'hidden' are pulled from the public feed but kept in the seller's
  // dashboard. Public feed requires verified=true AND status='active'.
  status                  String             @default("active")
  // Denormalized market-price position vs this item's brand+model+segment band, refreshed
  // nightly by /api/cron/price-stats: 'low' (below P25 → "Good price" card badge) | 'typical'
  // | 'high' | null (no reliable band). Approximate hint on cards; the PDP shows the exact
  // live band (getPriceBand). Added via raw ALTER (additive, no FK) — see image-hash-index.mjs.
  marketPosition          String?
  availabilityConfirmedAt DateTime? // last seller "still available" confirmation (reminder targeting)
  // ── Sale attribution (seller marks sold via the native confirm sheet) ──────────
  // Recorded when status→'sold'; cleared on reactivate. Additive scalars (no FK),
  // applied via scripts/sold-attribution-cols.mjs.
  soldChannel             String? // 'eno' (in-app buyer) | 'external' | null
  soldToProfileId         String?            @db.Uuid // the in-app buyer, when soldChannel='eno' (scalar; display resolves at read)
  soldPlatform            String? // free text external marketplace, when soldChannel='external'
  soldAt                  DateTime?
  // ── Two-sided sale confirmation (the trade loop, 2026-08-11) ───────────────────
  // ⚠️ READ THE PREFIXES. `sold*` above is what the SELLER DECLARED, unilaterally — it is
  // set by whichever of the five sold-writing paths ran, and one person's word is not a
  // trade. `sale*` below is what the MARKETPLACE OBSERVED: the buyer's own answer, plus
  // the number both sides agreed on. Trust and sold-price guidance read `sale*` ONLY.
  // Everything here is nullable with no backfill, so the currently-deployed revision keeps
  // working against the migrated DB (it simply never writes or reads these).
  // The pure rules live in src/lib/trade-loop.ts — never re-derive them at a call site.
  //
  // The agreed price, in VND, as the SELLER entered it on the mark-sold sheet. Deliberately
  // NOT `price`: a haggled item sells below its ask, and price guidance built from asks is
  // the thing this column exists to replace. null = the seller did not say.
  salePrice               Float?
  // The buyer tapped "Yes, I bought it". ONLY this makes the sale count for trust, and only
  // once BOTH sides have spoken does the review prompt appear (canPromptReview).
  saleConfirmedAt         DateTime?
  // The buyer tapped "No". Terminal-ISH: it stops every re-prompt forever and never counts
  // toward trust, but the seller may re-attribute the sale to a DIFFERENT buyer (they picked
  // the wrong person), which clears this stamp. See validateMarkSold.
  saleDeclinedAt          DateTime?
  // ⚠️ THE DURABLE PER-BUYER MEMORY, and the only thing that makes the anti-harassment and
  // anti-relitigation rules TRUE rather than merely intended. Compact JSON, owned end-to-end by
  // src/lib/trade-loop.ts (parseBuyerHistory / serializeBuyerHistory), one entry per buyer ever
  // asked on this listing: [{"i":"<profile uuid>","a":<first-asked ms>,"d":<declined ms>}].
  //
  // Everything else in this cluster describes the CURRENT attribution and is therefore wiped
  // whenever the seller re-attributes — which is exactly what two rounds of external review
  // broke, both times MEASURED against the draft before fixing:
  //   · A single "who declined" column: buyer A declines, seller attributes to B, B declines and
  //     OVERWRITES A, so A becomes nameable again with a fresh window.
  //   · A prompt clock keyed to the current channel: mark external, then mark the same buyer
  //     again, and both clocks restamp. A silent buyer took 300 notifications over 300 days.
  //   · A window keyed to soldAt: the intermediate external mark restamped it, so the window
  //     crept forward a day per round and never closed at all.
  //   · A restamp that skipped the cooldown: alternating the price hourly sent 336 notifications
  //     in 14 days against a documented maximum of three.
  //   · A plain slice() cap: naming 50 more buyers evicted the first decliner, who became
  //     nameable again. `a` is therefore the IMMOVABLE window anchor (never soldAt, which must
  //     stay free to mean "when it sold"), `p` is the price the buyer was last asked about, and
  //     declined entries are never evicted by the cap.
  // A per-buyer record survives every re-attribution, so none of the round-trips work.
  //
  // Cleared ONLY by a reactivation (a relisted item is genuinely a new sale). A scalar text
  // blob, like Listing.attributes beside it — no FK, additive, safe outside the push flow.
  saleBuyerHistory        String?
  // Last time the buyer was ASKED. The re-prompt is bounded by a cooldown from here AND a
  // deadline from soldAt (TRADE_LOOP in trade-loop.ts), which is why no attempt COUNTER is
  // needed: an unanswered prompt stops on its own instead of nagging forever.
  saleConfirmPromptedAt   DateTime?
  postedAt                DateTime           @default(now()) // also the feed-recency key; "confirm availability" bumps it
  views                   Int                @default(0)
  savedCount              Int                @default(0)
  featured                Boolean            @default(false)
  attributes              String?
  // Structured numeric specs (vehicles today; queryable as ranges, unlike the JSON
  // `attributes` blob). All optional — only set for categories that surface them.
  year                    Int? // model/manufacture year (vehicles)
  mileageKm               Int? // odometer in km (vehicles)
  engineL                 Float? // engine displacement in litres, e.g. 2.0 (cars)
  engineCc                Int? // engine displacement in cc, e.g. 150 (motorbikes)
  areaM2                  Float? // floor area in m² (property + property rentals)
  salaryM                 Int? // salary in million VND/month (jobs)
  reports                 Report[]
  contactReveals          ContactReveal[]
  /// Set only on a listingType='teacher' row — the listing IS the teacher's public card.
  teacherProfile          TeacherProfile?
  teacherJobMatches       TeacherJobMatch[]
  conversations           Conversation[]
  dailyStats              ListingDailyStat[]
  reviews                 Review[] // verified-buyer reviews that reference this listing
  contactCount            Int                @default(0) // distinct authenticated viewers who revealed contact
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Partner sync upserts by (sellerId, externalId) — unique per shop.
  @@unique([sellerId, externalId])
  // ── Indexes ─────────────────────────────────────────────────────────────────────────────────────────────────
  // ⛔ MOST OF THIS MODEL'S INDEXES ARE PARTIAL AND LIVE IN scripts/listing-index-diet-ddl.mjs (speed plan item 9,
  // 2026-10-17): Prisma cannot declare a partial index. Measured 2026-10-16: 141,032 rows, 2,122 live; 32 FULL
  // indexes = 500 MB, nearly all of it rows no public query returns, and every write to a non-live row (imports,
  // hides — 98.5% of the table) paid for all of them. Every index whose queries always ask for live rows is now
  // `WHERE verified AND status = 'active'` there: rank, category × rank, category × seller (the counts), the
  // subcategory / listingType / date feeds, brand, price, the range facets (year, areaM2, salaryM, mileageKm),
  // buildingKey, lat/lng, a live copy of the trigram search on searchText (public search), and per-seller rank. Unused:
  // views, complianceStatus, city, condition, featured, the two sellerTrustScore composites, verified + postedAt — each
  // dropped by the script only once Postgres records no scan of it for a week.
  // `prisma migrate diff` therefore lists the partial indexes as DROP INDEX — the safe flow (CLAUDE.md) refuses every
  // DROP, so it never applies one. ⚠️ Do not add a FULL index here for a column the script covers: its write cost on
  // 98% non-live rows is what the change removed. What stays below serves queries of ANY status.
  // Any-status reads: the admin console's listing table, the tombstone cron.
  @@index([verified, status, postedAt])
  // The Category foreign-key check, and category-wide admin reads.
  @@index([categoryId])
  // ── Trade loop (each index written for ONE named query) ───────────────────────
  // ⚠️ THE COLUMN ORDER IS THE POINT. A B-tree serves leading equality predicates and then
  // ONE trailing range; `IS NULL` is an equality-class predicate and is indexable, so the
  // "not answered yet" columns sit in the equality prefix, not after the range.
  //
  // ⚠️ AND THESE INDEXES ARE THE ACCESS PATH, NOT THE PREDICATE LIST. A reviewer caught the
  // first draft writing each query as ONLY the indexed columns — which is a weaker filter
  // than the module enforces, and these comments are what the query author copies. Every
  // WHERE below is written in FULL; the index covers the selective prefix and Postgres
  // applies the rest as residual filters. The authority on "does this sale count" is
  // src/lib/trade-loop.ts (countsTowardTrust / canRespondToSale) — never a SQL predicate
  // reconstructed from memory.
  //
  // ⛔ AND EVERY CONSUMER MUST **ALSO** AND IN THE EDITION SCOPE. Visa/itinerary products are
  // ordinary Listing rows (the shared-desk design), so a sweep or badge built from these
  // predicates alone crosses the eno.vn / eno.forum boundary: an eno.vn user is asked to
  // confirm a visa purchase, and confirmed visa sales are summed into a public marketplace
  // trust score. These WHEREs are complete for the TRADE LOOP and for nothing else — see
  // src/lib/edition-scope.ts.
  //
  // (1) The buyer's own pending prompt — "what am I being asked to confirm?", run on every
  //     notification-badge read for a signed-in buyer:
  //       WHERE "soldToProfileId" = $me AND status = 'sold' AND "soldChannel" = 'eno'
  //         AND "saleConfirmedAt" IS NULL AND "saleDeclinedAt" IS NULL
  //         AND "soldAt" >= now() - interval '14 days'   -- TRADE_LOOP.CONFIRM_WINDOW_DAYS
  //         AND "complianceStatus" <> 'taken_down'
  //     (status/soldChannel/soldAt matter: without them the badge counts prompts on
  //     reactivated listings and on sales whose confirm window has already closed.)
  //     soldToProfileId had NO index at all before 2026-09 (measured: pg_indexes on
  //     "Listing" matched nothing containing 'sold'), so this query was a seq scan.
  //     ⚠️ Its index is PARTIAL since 2026-10-17 — `Listing_soldToProfileId_pending_idx`, WHERE
  //     "soldToProfileId" IS NOT NULL — and so lives in scripts/listing-index-diet-ddl.mjs.
  // (2) A re-prompt sweep was planned with its own index; it was never built, and the index (0 scans in
  //     26 days) is retired by scripts/listing-index-diet-ddl.mjs (2026-10-17). Give a sweep an index when one exists.
  // (3) Trust's transaction count, which after this wave reads CONFIRMED sales instead of
  //     approximating from Listing.updatedAt (src/lib/trust.ts):
  //       WHERE "sellerId" = $seller AND status = 'sold' AND "soldChannel" = 'eno'
  //         AND "soldToProfileId" IS NOT NULL AND "saleDeclinedAt" IS NULL
  //         AND "saleConfirmedAt" >= $txSince
  //         AND "complianceStatus" <> 'taken_down'
  //     Equality on sellerId, range on saleConfirmedAt. The channel/buyer/declined clauses
  //     are what stop a contradictory or reactivated row counting here while saleState()
  //     reads it as declined or unsold.
  @@index([sellerId, saleConfirmedAt])
  // NOTE — deliberately NO index for sold-price guidance. Its consumer is the nightly
  // /api/cron/price-stats aggregate, which reads the whole table by brand+model in one
  // pass; a row-level index does not serve a full aggregate and would only cost writes.
  // Accelerates the accent-folded search (`searchText LIKE '%term%'`). Requires the pg_trgm extension. Since 2026-10-17
  // public search reads a PARTIAL live copy (Listing_live_searchText_trgm_idx, scripts/listing-index-diet-ddl.mjs); this
  // FULL one stays for admin search, which reads every status ('all' by default): measured without it 150–800 ms per
  // query (a sequential read of the whole table), with it 1–20 ms.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Append-only price audit — one row per actual price change, written inside
// updateListingCore (the single choke point shared by the web PATCH and the
// partner API). Powers the EU-Omnibus-style reference price (lowest offered in
// the trailing 30 days) that makes raise-then-drop fake discounts impossible,
// and doubles as the proof trail for the drop badge the platform renders.
model PriceChange {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  oldPrice  Float
  newPrice  Float
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
}

// One row per (listing, authenticated viewer) who revealed the seller's contact.
// ── TEACHERS (owner, 2026-09-30) ─────────────────────────────────────────────────────────────
// A teacher profile is materialised as ONE Listing (listingType 'teacher', category 'teachers') so
// the explorer, PDP, SEO and chat are reused; this table holds the structured profile.
// ⛔ TEACHER ROWS ARE EXCLUDED FROM EVERY LISTING QUERY BY DEFAULT (scopedListingWhere) and opted
// back in only on the teacher surfaces — a denylist of feeds would leak them (plan review 09-30).
// ⛔ NO CONTACT DATA HERE. Phone/email/CV live in TeacherPrivate, read only via src/lib/teachers/private.ts,
// so no `include` of this model can ever put them into listing JSON.
model TeacherProfile {
  id                 String   @id @default(cuid())
  profileId          String   @unique @db.Uuid
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  listingId          String?  @unique
  listing            Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  status             String   @default("live") // live | hidden
  fullName           String
  headline           String
  bio                String   @default("")
  photoUrl           String?
  videoUrl           String?
  /// INTRO VIDEO VISIBILITY (owner, 2026-10-07) — the teacher's choice: false = shown on the profile (videoUrl and
  /// Listing.video); true = kept private (TeacherPrivate.videoPath) and sent to schools that ask. A video has EXACTLY
  /// ONE home — rules and moves in src/lib/teachers/video.ts.
  videoOnRequest     Boolean  @default(false)
  /// SERVER-WRITTEN, bumped on every video change (upload, move, removal, choice): the stamp an edit form sends back
  /// as `videoBase`, so a stale window can never publish, hide or delete over a newer choice. Never in TeacherInput.
  videoVersion       Int      @default(0)
  nationality        String   // ISO-3166 alpha-2
  /// MIRROR since 2026-10-08: englishLevel === 'native' (projection.ts teacherMirrors) — kept for the old readers.
  nativeSpeaker      Boolean  @default(false)
  /// other languages spoken — readable names (no ISO-code column in v1)
  languages          String[] @default([])
  /// a hub slug (src/lib/teachers/places.ts HUBS) when livesIn = 'city', else '' — no longer always set
  currentCity        String
  /// MIRROR since 2026-10-08: the curated Vietnamese DISTRICTS name of currentDistrictKey (what Listing.district holds)
  currentDistrict    String?
  /// MIRROR since 2026-10-08: the city level of teachAreas (places.ts mirrorCities) — the external matcher reads it
  preferredCities    String[] @default([])
  /// MIRROR since 2026-10-08: 'online' is in teachAreas
  openToOnline       Boolean  @default(false)
  /// the first day of a month
  availableFrom      DateTime?
  jobTypes           String[] @default([])
  ageGroups          String[] @default([])
  subjects           String[] @default([])
  /// MIRROR since 2026-10-08: the stored number while it falls in experienceBand, else the band's lower bound
  yearsExperience    Int      @default(0)
  /// ── THE SITUATION (teacher onboarding redesign, owner 2026-10-08) — rules in src/lib/teachers/places.ts + profile.ts.
  /// ⛔ ONE SHAPE: situationVersion is SERVER-WRITTEN (TEACHER_SITUATION_VERSION) by every save and by
  /// scripts/teachers-backfill.ts; NULL = a row the old code wrote and the backfill has not migrated. No runtime adapter
  /// reads the old columns as answers — they are mirrors (above). Columns: scripts/teachers-ddl.mjs (additive only).
  /// "Where are you now?" — 'city' | 'elsewhere' | 'abroad'; NULL = not answered (never defaulted)
  livesIn               String?
  /// vn-units code of a province no city chip covers whole (places.ts PROVINCE_PLACES) — only for 'elsewhere'
  currentProvince       String?
  /// a curated HCMC DISTRICTS slug (HCMC only); currentDistrict keeps the display name
  currentDistrictKey    String?
  /// THE one "Where you can teach" list: 'online', hubs, HCMC districts, 'p-<code>', 'anywhere' (≤40, CHECK)
  teachAreas            String[]  @default([])
  /// when the teacher last confirmed (or edited) that list in the form — server-written; NULL for backfilled lists
  teachAreasConfirmedAt DateTime?
  /// languages taught under "Other language" — readable names (≤8, CHECK)
  teachLanguages        String[]  @default([])
  /// 'native' | 'fluent' | 'working'; NULL = not asked (no English-medium subject) or not answered
  englishLevel          String?
  /// the experience facet's bucket; NULL = not answered
  experienceBand        String?
  situationVersion      Int?
  /// [{role, employer, city, from, to}] — validated by src/lib/teachers/profile.ts
  experience         Json     @default("[]")
  degreeLevel        String?  // none | associate | bachelor | master | phd
  degreeMajor        String?
  degreeInstitution  String?
  degreeYear         Int?
  /// [{type, hours?, provider?, year?}] — DATA ONLY, no documents are ever uploaded
  certificates       Json     @default("[]")
  expectedSalaryM    Float?   // expected monthly salary, millions VND
  /// Consents — unbundled (VN PDP Law 91/2025). Public profile is the service itself; the two
  /// below are optional and default OFF.
  /// consentPublicAt: when the CURRENT public consent was given (a save under a newer notice moves it).
  consentPublicAt    DateTime
  staffContactOptIn  Boolean  @default(false)
  matchEmailOptIn    Boolean  @default(false)
  consentAt          DateTime @default(now())
  lastMatchedAt      DateTime?
  /// ⛔ CONSENT EVIDENCE (teacher onboarding redesign, plan review C2, 2026-10-08 — PDP Law 91/2025 Art 9(4)(d), Decree
  /// 356/2025 Art 6(3)): every consent act stores its time AND the notice version shown, and a withdrawal its time. All
  /// SERVER-WRITTEN (src/lib/teachers/publish.ts optInWrites), never in TeacherInput.
  /// The Publish notice the teacher published under (PUBLISH_NOTICE_VERSION); NULL = the old consent tick-box (2 rows).
  consentPublicVersion      String?
  /// "Email me jobs that match my profile" — on: when + AI_NOTICE_VERSION; off: when. ⛔ Only an opt-in under the
  /// CURRENT AI notice (Claude Haiku 5.5, Anthropic) sends the teacher to the matcher (profile.ts aiMatchConsented).
  matchEmailOptInAt         DateTime?
  matchEmailNoticeVersion   String?
  matchEmailWithdrawnAt     DateTime?
  /// "Our staff may call me" — the same three records.
  staffContactOptInAt       DateTime?
  staffContactNoticeVersion String?
  staffContactWithdrawnAt   DateTime?
  /// COVER LESSONS (owner, 2026-10-07) — an add-on to the job-seeking profile: weekly free periods,
  /// an hourly rate and the areas the teacher will travel to. Rules in src/lib/teachers/cover.ts.
  /// ⛔ Every column below except the four the teacher edits (coverOpen, coverSlots, coverAreas,
  /// coverRateVnd) is SERVER-WRITTEN — never in TeacherInput, so neither a request body nor the
  /// teacher.eno.vn `#d=` fragment can set it.
  coverOpen          Boolean  @default(false)
  /// '<mon|tue|wed|thu|fri|sat|sun>-<am|pm|eve>' — ONE combined key per slot (≤21)
  coverSlots         String[] @default([])
  /// cover-area keys: HCMC district slugs or a city-wide workIn slug (≤40, COVER_LIMITS.areas). ⚠️ DERIVED since
  /// 2026-10-08: the teach areas inside the home province (places.ts coverReachOf), rewritten by every save.
  coverAreas         String[] @default([])
  /// whole VND per hour
  coverRateVnd       Int?
  /// when the teacher last CONFIRMED their availability: cover switched on, a period/area/rate changed, or
  /// "Still available" — a save that only edited the bio leaves it (publish.ts coverWrites)
  coverConfirmedAt   DateTime?
  /// SEPARATE consent (VN PDP Law 91/2025 — specific, unbundled, provable): when and under which
  /// copy version cover was last switched on, and when it was last switched off (withdrawal).
  /// ⚠️ coverWithdrawnAt is HISTORY, not state: it keeps the LAST withdrawal after a re-grant. Cover is on
  /// iff coverOpen; a re-grant shows as a coverConsentAt later than coverWithdrawnAt.
  coverConsentAt      DateTime?
  coverConsentVersion String?
  coverWithdrawnAt    DateTime?
  /// "IDENTITY VERIFIED" (owner, 2026-10-15) — the teacher's OPT-IN to show that eno checked their identity: on the
  /// profile, on its card in lists, and as a chip to the school or member chatting with them. A SEPARATE consent (VN PDP
  /// Law 91/2025 — specific, unbundled, provable), OFF by default, saved only by its own switch (src/lib/teachers/
  /// publish.ts saveTeacherIdentityMark — never the profile save, never in TeacherInput, never in a draft). The switch
  /// is the consent, NEVER the evidence: the mark shows only while the identity check is LIVE and fullName is within the
  /// ID's name (src/lib/teachers/identity-mark.ts), and nothing about the document ever leaves the server.
  identityMarkOn            Boolean   @default(false)
  /// ⛔ THE THREE BELOW ARE SERVER-WRITTEN AND NEVER BACKFILLED: when and under which IDENTITY_MARK_NOTICE_VERSION the
  /// switch was last turned on, and when it was last turned off (publish.ts optInWrites). An edit form sends the two
  /// times it loaded as the switch-on's compare-and-set base, so a stale tab can never re-grant a withdrawal.
  /// ⚠️ identityMarkWithdrawnAt is HISTORY, not state (as coverWithdrawnAt): the switch is on iff identityMarkOn; a
  /// re-grant shows as an identityMarkAt later than identityMarkWithdrawnAt. Columns: scripts/teachers-ddl.mjs.
  identityMarkAt            DateTime?
  identityMarkNoticeVersion String?
  identityMarkWithdrawnAt   DateTime?
  /// "HIDE MY PROFILE FROM SEARCH ENGINES" (owner decision 14, 2026-10-20) — the teacher's own switch, saved only by its
  /// own endpoint (PUT /api/teachers/me/search → src/lib/teachers/search-visibility.ts; never in TeacherInput or a draft).
  /// On: the profile page is `noindex` and left out of every sitemap — eno still shows it to everyone. One verdict with
  /// the quality floor: src/lib/teachers/search-floor.ts. Column: scripts/teacher-search-hide-ddl.mjs (additive only).
  hideFromSearch            Boolean   @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  private            TeacherPrivate?
  /// Every school that saw this teacher's Zalo for urgent cover (2026-10-28 — src/lib/teachers/zalo.ts).
  zaloReveals        TeacherZaloReveal[]
  matches            TeacherJobMatch[]
  /// eno Classroom (2026-10-25): this teacher's AI avatar (one per teacher).
  classroomAvatar    ClassroomAvatar?

  @@index([status, currentCity])
}

/// ⛔ The only place teacher contact data lives. Revealed to a recruiter ONLY through an active
/// TeacherContactShare on their conversation (src/app/api/teachers/contact) — the phone only when that share's
/// `phoneShared` says its tap included it (gate review, 2026-10-09) — EXCEPT `coverZalo` (owner, 2026-10-28): the Zalo
/// number a teacher with cover ON chose to show schools for urgent cover, revealed by src/lib/teachers/zalo.ts.
model TeacherPrivate {
  teacherProfileId String         @id
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  phone            String?
  email            String?
  /// "Zalo for urgent cover" (owner, 2026-10-28): a VN mobile (0 + 9 digits) the teacher switched on; NULL = off. Shown
  /// to a school that asks on the profile, within its daily cap — never in the page, an export to anyone else, or a log.
  /// Switched off, or cover switched off, it is DELETED (set NULL) and the withdrawal stamped. Columns:
  /// scripts/teacher-zalo-ddl.mjs.
  coverZalo            String?
  /// When the teacher last switched it on or gave a new number — the GRANT a reveal discloses (TeacherZaloReveal.grantAt).
  coverZaloAt          DateTime?
  /// The notice that grant was given under (src/lib/teachers/zalo.ts COVER_ZALO_NOTICE_VERSION).
  coverZaloVersion     String?
  /// When it was last switched off (by the teacher, or by cover going off).
  coverZaloWithdrawnAt DateTime?
  /// Object path in the PRIVATE bucket `teacher-cvs` — never a URL; served by 10-minute signed URL.
  cvPath           String?
  cvFileName       String?
  /// The PRIVATE intro video (TeacherProfile.videoOnRequest): an object path in the private bucket `teacher-videos`
  /// (`<profileId>/<uuid>.<ext>`) — never a URL; a school the teacher sent it to gets a 10-minute signed URL.
  videoPath        String?
  updatedAt        DateTime       @updatedAt
}

/// The teacher's explicit, revocable "share my phone, email & CV" in one thread (owner 09-30:
/// a tap, not any reply — "no thanks" must not unlock anything).
model TeacherContactShare {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sharedAt       DateTime     @default(now())
  revokedAt      DateTime?
  /// ⛔ THE TAP INCLUDED THE PHONE (gate review, 2026-10-09). Since A3 (owner, 2026-10-08) the phone is optional,
  /// so a teacher with none shares "email & CV" — and /api/teachers/contact served the CURRENT private row, so a
  /// phone added later reached every school they had shared "email & CV" with. A share hands over what its tap
  /// named, nothing added since: the phone only while this is true. Stamped by every write in
  /// src/app/api/teachers/share (a re-share re-stamps it — "Share my phone too"). Default TRUE because every row
  /// before it was made while a phone was required, under the line "Shared my phone, email and CV" — and so a
  /// rolled-back revision, which never writes it, still inserts. Column: scripts/teachers-ddl.mjs.
  phoneShared    Boolean      @default(true)
}

/// A teacher's PRIVATE intro video, sent to one school in one conversation (owner, 2026-10-07: "show their intro video
/// in profile or hide and send upon request"). ⛔ ITS OWN TABLE, NOT TeacherContactShare: there a row with revokedAt
/// null already MEANS "phone, email and CV shared" — a video grant must never unlock contact details, nor the reverse.
/// requestedAt = the school asked; sharedAt (with revokedAt null) = the teacher sent it. A request alone unlocks
/// nothing. Gate: src/lib/teachers/share.ts teacherThread. Columns: scripts/teachers-ddl.mjs.
model TeacherVideoShare {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestedAt    DateTime?
  sharedAt       DateTime?
  revokedAt      DateTime?
}

/// A teacher's UNFINISHED profile (owner, 2026-10-11: every step saved and resumable). PRIVATE — the account's own; never
/// a consent, an upload, the cover switch or the phone (src/lib/teachers/draft.ts). `rev`: the compare-and-swap revision
/// every save checks and bumps (/api/teachers/me/draft). DDL: scripts/teachers-ddl.mjs (RLS on, no policies).
model TeacherDraft {
  profileId String   @id @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  data      Json
  step      String
  rev       Int      @default(1)
  /// The draft's generation: a fresh random id each time a draft is made — a draft deleted and made again is never
  /// taken for the old one (src/lib/teachers/draft.ts).
  gen       String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([updatedAt])
}

/// Message emails to teachers (owner, 2026-10-12; v2 the same day: "maximum 3 reminders 1 hr 24 hours 3 days"). One row per
/// teacher: `lastEmailAt` keeps two emails at least an hour apart and is the compare-and-set the cron claims on; `optedOutAt`
/// is the List-Unsubscribe switch (list=teacher-messages). Holds no address and no message text. Rule:
/// src/lib/teachers/message-emails.ts. DDL: scripts/teachers-ddl.mjs (RLS on, no policies).
model TeacherMessageEmailState {
  profileId   String    @id @db.Uuid
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lastEmailAt DateTime?
  optedOutAt  DateTime?
  updatedAt   DateTime  @default(now())
}

/// One row per teacher thread (one per school, Conversation @@unique([listingId, buyerProfileId])): the LAST email about it —
/// `emailedAt` when, `kind` which stage of which episode. An episode starts at the oldest unread school message (or, after
/// its third email, at the next message) and is over once the teacher reads. A row is never moved on within 24 h of its email, which is what
/// makes counting these rows an exact 4-in-24-h cap. An undo after a refused send moves the row back only while it still
/// holds that claim's time.
model TeacherMessageEmailThread {
  conversationId String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// The teacher — cascades with the account (Opus, plan review: Conversation.sellerProfile is SetNull, so without this
  /// key the row would outlive a deleted account).
  profileId      String       @db.Uuid
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  emailedAt      DateTime
  /// The stage this email recorded and its episode's anchor: 'first' (an hour after the anchor), 'second' (a day after),
  /// 'third' (three days after — the last), written as `first@<anchor ISO time>` (src/lib/teachers/message-emails.ts
  /// kindFor). v1 wrote 'new' (≡ first) and 'reminder' (≡ second), with no anchor. The column default is v1's and is never
  /// relied on: every write names its kind.
  kind           String       @default("new")

  @@index([profileId])
}

/// Written by the LOCAL matcher (~/eno-lead-pipeline teachersMatch). Exactly one of
/// teacherProfileId / leadId is set (CHECK in scripts/teachers-ddl.mjs): FB job-seeker leads have
/// no eno account.
model TeacherJobMatch {
  id               String          @id @default(cuid())
  teacherProfileId String?
  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  leadId           String?
  listingId        String
  listing          Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  score            Int
  reasons          Json            @default("[]")
  concerns         Json            @default("[]")
  decision         String          // match | reject_sample (below threshold, logged for labels)
  modelVersions    Json            @default("{}")
  staffStatus      String?         // called | interested | hired | not_fit
  createdAt        DateTime        @default(now())
  emailedAt        DateTime?

  @@unique([teacherProfileId, listingId])
  @@unique([leadId, listingId])
  @@index([emailedAt, decision])
}

/// D3 — THE JOB-AD HISTORY LOG (~/eno-seo-teachers-2026-10/PLAN.md §3(d), 2026-10-19: "Start the log now … store
/// first_seen, last_seen and parsed fields for every ingested ad. Publish later, only after counsel"). One row per
/// third-party job ad scripts/import-jobs.ts takes in — one its run keeps: mapped, past every screen, cover found — keyed
/// by the importer's own externalId; each later daily stage that carries the ad moves lastSeenAt and seenCount and
/// refreshes the facts. The one writer is src/lib/job-ad-sightings.ts.
/// ⛔ INTERNAL ONLY: no page, feed, API or email reads it, and nothing from it is published before counsel and each
/// board's terms allow — then aggregates only, never ad text, "work permit support" and never a visa or TRC figure.
/// ⛔ PARSED FACTS ONLY: no ad text, no pay line as written, no email or phone, no employer line read as a person's, no visa /
/// TRC / residence field. The one flag is workPermitSupport, kept as the boolean alone (never the words it was read from).
/// ⚠️ DELIBERATELY FK-FREE (the WhatsAppInbound call): `listingId` is a plain pointer, so this ships as one additive
/// CREATE TABLE that takes no lock on the busy Listing table, and an ad's history outlives its row.
/// DDL: scripts/job-ad-sightings-ddl.mjs (RLS on, anon/authenticated revoked) — run on production BEFORE the deploy.
model JobAdSighting {
  /// `<board>:<the board's own job id>` — the ad's Listing.externalId (jobExternalId, src/lib/job-listing.ts).
  externalId        String    @id
  /// The JOB_BOARDS key: "careerlink", "teast", "vtj"…
  board             String
  /// The `stagedAt` of the first and of the latest stage that carried the ad — when the pipeline re-checked it live, not
  /// the import's clock. ⚠️ The pipeline stages a posting for at most 14 days after its (latest) posting date.
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  /// Stages that carried the ad, imported in time order (the daily job's order; the pipeline stages once a day); a stage
  /// imported twice counts once. ⚠️ A stage whose time falls strictly between firstSeenAt and lastSeenAt is not counted,
  /// so a backfill from old stage files must run NEWEST FIRST.
  seenCount         Int       @default(1)
  /// The eno listing the ad is (or was) published as, once one exists.
  listingId         String?
  /// The posting's own title, whitespace-collapsed and un-shouted — without the " — employer" the listing title adds. The
  /// words the public listing shows, past the phone, contact and visa screens; a person's name inside it is not detected.
  title             String
  /// The vn-units province (Listing.city); the importer parses no district.
  city              String
  /// As the board shows it — a line the name check reads as a person's ("Ms Ngân English", "Chị Hoa", "Nguyễn Thị Lan")
  /// is left out (namesAPerson, a heuristic: titles, common surnames, common English given names).
  employer          String?
  /// The jobs `jobtype` facet value: fulltime | parttime | contract | temporary.
  employmentType    String?
  /// The pay the importer reads (parseJobPayRange): VND a month or an hour; salaryMax is null for "from …".
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?
  salaryPeriod      String?
  /// "Work permit support" (workPermitSupportOf), read from the title and the RAW pay/benefit line: true = the ad says
  /// the employer provides, supports, sponsors, arranges or helps with a work permit; null = it names a work permit
  /// without saying so ("must hold a work permit"); false = it names none. The boolean only — never the words.
  workPermitSupport Boolean?
  /// The pipeline's search (teaching | english), and eno's Jobs subcategory (teaching | job-other).
  category          String
  subcategory       String
  /// Vietnam days. postedOn is the EARLIEST posting day any stage carried, lastPostedOn the LATEST: a board that re-posts
  /// the job under the same link moves lastPostedOn, never firstSeenAt — count re-posts by lastPostedOn's week.
  /// ⚠️ applyBy is the listing's: the posting's own deadline, capped at 14 days after posting.
  postedOn          DateTime  @db.Date
  lastPostedOn      DateTime  @db.Date
  applyBy           DateTime? @db.Date

  @@index([board, firstSeenAt])
}

/// TEACHER JOB DMs (owner, 2026-10-20: "send related jobs cover lessons to our teachers in chat inside eno.vn from the admin
/// account") — src/lib/teachers/job-dms. A job or cover post from a Facebook group (contacts redacted on the Mac), a
/// LinkedIn job-alert email or a post the outreach team forwarded. ⛔ PRIVATE: never a Listing, never public, never
/// quoted to anyone — a teacher gets eno's own summary and the link. Deleted after JOB_DM_RULES.retentionDays.
/// DDL: scripts/teacher-job-dms-ddl.mjs (RLS on, no policies).
model ExternalJobPost {
  id           String    @id @default(cuid())
  /// 'fb' | 'linkedin' | 'intake'
  source       String
  /// fb: '<groupId>:<postId>' · linkedin: the job id · intake: the forwarded email's Message-ID hash
  externalKey  String
  /// the group's name / 'LinkedIn' / 'Forwarded by the eno team'
  sourceName   String
  /// the group id or the alert's search
  sourceRef    String?
  /// fb: the group is PUBLIC (a member-only post cannot be opened by the teacher — never sent); null = not known
  groupPublic  Boolean?
  /// the canonical link the teacher opens (FB permalink, linkedin.com/jobs/view/<id>)
  url          String?
  /// intake only: the "Apply:" line the team member wrote — the application path
  applyText    String?
  title        String?
  company      String?
  locationText String?
  /// the post text (redacted), ≤ 6000 chars (CHECK)
  text         String
  /// run.ts textSig: the same ad cross-posted to several groups (or forwarded twice) has one signature — the first kept
  textSig      String?
  lang         String?
  postedAt     DateTime?
  receivedAt   DateTime  @default(now())
  /// 'new' | 'ready' | 'held' | 'dropped' | 'expired'
  status       String    @default("new")
  statusReason String?
  /// extract.ts RuleFacts + laya answers + the merged decision (facts.ts), versioned by factsVersion
  facts        Json?
  factsVersion String?
  expiresAt    DateTime?
  updatedAt    DateTime  @default(now())

  @@unique([source, externalKey])
  @@index([status, receivedAt])
  @@index([expiresAt])
  @@index([textSig])
}

/// The teacher's "Message me matching jobs and cover lessons in eno chat" switch — its OWN consent (VN PDP Law 91/2025:
/// specific, unbundled, provable), apart from the email and staff-call opt-ins. On: optIn + optInAt + noticeVersion
/// (JOB_DM_NOTICE_VERSION); off: withdrawnAt (history, as coverWithdrawnAt). invitedAt = the one bell invite went out.
model TeacherJobDmConsent {
  profileId     String    @id @db.Uuid
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  optIn         Boolean   @default(false)
  optInAt       DateTime?
  noticeVersion String?
  withdrawnAt   DateTime?
  invitedAt     DateTime?
  /// set when a reply MAY have asked to stop (replies.ts mayBeOptOut): nothing is sent until the teacher says "Keep sending
  /// jobs" or switches it on again — never lifted by time or by any other reply (run.ts processStops)
  pausedAt      DateTime?
  updatedAt     DateTime  @default(now())
}

/// One job offered to one teacher. ⛔ THE NEVER-TWICE LEDGER: unique (profileId, jobKey, mode) — written in the SAME batch
/// transaction as the message (insertMessage alongside), so a DM and its rows commit together or not at all. 'shadow'
/// rows are what a shadow run would have sent; they never block or count for 'live'.
model TeacherJobDm {
  id             String   @id @default(cuid())
  profileId      String   @db.Uuid
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// 'post:<ExternalJobPost.id>' | 'listing:<Listing.id>'
  jobKey         String
  /// 'live' | 'shadow'
  mode           String
  /// 'jobs' | 'cover' — the message it went in (a shadow run keeps live's one-of-each-a-day by it)
  kind           String
  /// the Vietnam date it was offered, YYYY-MM-DD
  day            String
  conversationId String?
  score          Int
  reasons        Json     @default("[]")
  /// shadow only: the message text that would have been sent (graded before go-live)
  preview        String?
  createdAt      DateTime @default(now())

  @@unique([profileId, jobKey, mode])
  @@index([profileId, day])
}

/// ⛔ THE PER-DAY CAP, as a key: one row per (teacher, Vietnam day, kind) — 'jobs' | 'cover'. Inserted with the message
/// (alongside): a second message of the same kind the same day violates the key and rolls the whole batch back.
model TeacherJobDmDay {
  profileId      String   @db.Uuid
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  day            String
  kind           String
  conversationId String
  sentAt         DateTime @default(now())

  @@id([profileId, day, kind])
}

// A lead signal + the dedupe key so contactCount counts distinct viewers, not clicks.
// viewerId = Supabase auth user id (no app Profile table required for Phase 1).
model ContactReveal {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewerId  String // auth.users.id (uuid string)
  ipHash    String? // salted hash of client IP — abuse signal, never the raw IP
  createdAt DateTime @default(now())

  @@unique([listingId, viewerId])
  @@index([listingId])
  @@index([viewerId])
}

// In-app conversation between a buyer (always an account) and a seller's
// storefront, scoped to a listing. sellerProfileId is NULL until the seller
// claims their business profile, at which point existing threads light up.
// Denormalized last-message + unread counts power the inbox/badge without N+1.
model Conversation {
  id                String    @id @default(cuid())
  /// NULL = a SUPPORT thread. Every other conversation is anchored to a listing; support has no
  /// listing to anchor to, and inventing a placeholder one would put it in browse, search, the
  /// sitemap and the product feeds. Applied by scripts/support-thread-ddl.mjs.
  /// ⚠️ `@@unique([listingId, buyerProfileId])` below STOPS CONSTRAINING once this is null, because
  /// Postgres treats NULLs as distinct — the partial index `Conversation_support_thread_key`
  /// (buyerProfileId WHERE listingId IS NULL) is what keeps it to one support thread per person.
  listingId         String?
  listing           Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerProfileId    String    @db.Uuid
  buyer             Profile   @relation("BuyerConversations", fields: [buyerProfileId], references: [id], onDelete: Cascade)
  sellerId          String
  seller            Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerProfileId   String?   @db.Uuid // null until the seller claims their account
  sellerProfile     Profile?  @relation("SellerConversations", fields: [sellerProfileId], references: [id], onDelete: SetNull)
  messages          Message[]
  /// Teachers: the teacher's revocable "share my phone, email & CV" grant for THIS thread.
  teacherContactShare TeacherContactShare?
  teacherVideoShare   TeacherVideoShare?
  /// Teachers: the last message email about this thread's current unread episode (src/lib/teachers/message-emails.ts).
  teacherMessageEmail TeacherMessageEmailThread?
  lastMessageAt     DateTime  @default(now())
  lastMessageText   String?
  buyerUnread       Int       @default(0)
  sellerUnread      Int       @default(0)
  // Per-user inbox hide ("delete conversation"): set to now() when that side
  // deletes the thread. The inbox query hides it until a newer message arrives
  // (lastMessageAt > the timestamp), so it reappears if the other party replies.
  // Non-destructive — the conversation + messages stay intact for the other side.
  buyerDeletedAt    DateTime?
  sellerDeletedAt   DateTime?
  // Visa-in-DM: binds ONE thread to ONE row in the Supabase-side visa_applications
  // table (e-Visa cases live outside this schema — service-role/PostgREST, never
  // Prisma), so a structured visa card can only ever speak for the application its
  // thread is bound to. Deliberately a SCALAR with no relation/FK: the target table
  // isn't in this datamodel, and an additive nullable column is safe outside the
  // profile_auth_fk push flow (same class as the sold-attribution scalars).
  // Set server-side ONLY, after verifying visa_applications.user_id == buyerProfileId.
  // @unique = at most ONE thread per case (Postgres treats NULLs as distinct, so every
  // ordinary conversation still fits), which also makes the payment-confirm callback's
  // application→thread lookup a findUnique instead of an ambiguous scan.
  // A thread MAY be rebound (a repeat applicant opens a second case in the same
  // buyer↔seller thread). Cards from the previous case stay in the timeline and are
  // self-describing — renderers must treat a card whose meta.applicationId ≠ this
  // column as HISTORY (never actionable).
  visaApplicationId String?   @unique @db.Uuid
  createdAt         DateTime  @default(now())

  @@unique([listingId, buyerProfileId]) // one thread per buyer per listing
  @@index([buyerProfileId])
  @@index([sellerProfileId])
  @@index([sellerId])
  @@index([lastMessageAt])
  // Inbox query is `WHERE buyer=me OR seller=me ORDER BY lastMessageAt DESC`. These
  // composites let each side of the OR be served index-ordered (no sort) so the
  // conversation list stays sub-ms as the table grows to millions of rows.
  @@index([buyerProfileId, lastMessageAt(sort: Desc)])
  @@index([sellerProfileId, lastMessageAt(sort: Desc)])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderProfileId String       @db.Uuid
  sender          Profile      @relation(fields: [senderProfileId], references: [id], onDelete: Cascade)
  body            String
  // Structured cards live in the message timeline. `kind` is a plain TEXT column
  // (never a DB enum) so a new card type is an additive code change, not a DDL one.
  //   'text'          — a normal chat message
  //   'offer'         — carries offerAmount + offerStatus (accept/decline/counter)
  //   'visa_step'     — one step of the in-thread e-Visa wizard (metaJson)
  //   'visa_checkout' — the in-thread pay card (metaJson)
  kind            String       @default("text") // 'text' | 'offer' | 'visa_step' | 'visa_checkout'
  offerAmount     Float? // VND, set when kind='offer'
  offerStatus     String? // 'pending' | 'accepted' | 'declined' | 'countered'
  // Structured card payload as a JSON string; NULL for 'text'/'offer'. Validated on
  // WRITE against the versioned shapes in src/lib/messages.ts — nothing else may
  // write it. ⚠️ NEVER holds visa PII: ids, step numbers, a money amount and payload
  // FIELD NAMES only. The applicant's answers stay in the encrypted
  // visa_applications payload and are fetched per-render.
  metaJson        String?
  /// RECALL, NOT ERASURE — the message stays in the row and only the participants stop seeing it.
  /// A marketplace with a dispute center cannot let one party destroy the evidence the other party
  /// is about to file a report about: Report.conversationId exists precisely so an admin can read
  /// the thread when adjudicating a scam or harassment case. So "Delete" hides the body from both
  /// inboxes and both threads, and leaves it readable to admin.
  /// ⛔ ONLY 'text' MAY BE RECALLED. An 'offer' carries live accept/decline/counter state the UI
  /// and the offer routes read, and every card kind is a step in a wizard — hiding either would
  /// strand a flow, not tidy a conversation.
  deletedAt       DateTime?
  /// The message this one replies to, in the SAME conversation (enforced on write — a self-FK
  /// cannot express "same parent"). SetNull rather than Cascade: a quoted message that is hard-
  /// deleted must not take the reply with it.
  replyToId       String?
  replyTo         Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies         Message[]    @relation("MessageReplies")
  createdAt       DateTime     @default(now())

  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  /// Covering index for the self-FK — the same unindexed-FK class Supabase's performance advisor
  /// flagged on senderProfileId, and it is what makes the SetNull sweep on a hard delete cheap.
  @@index([replyToId])
  // Covering index for the senderProfileId FK (joins + cascade-delete checks); was
  // flagged unindexed by Supabase's performance advisor. Applied to prod via migration
  // add_message_senderprofileid_index (matching Prisma's default index name).
  @@index([senderProfileId])
}

/// One person's one reaction to one message — the Zalo-style tap-back.
///
/// ⚠️ `emoji` IS THE UNICODE SEQUENCE, NOT A NAME OR AN ID. Storing "❤️" rather than "heart"
/// means the reaction still renders if the Lottie art is ever dropped, retimed or renamed: the
/// animation is a presentation layer over a character that stands on its own. It also makes the
/// global tally below a plain GROUP BY with nothing to join.
///
/// ⚠️ VALIDATED ON WRITE AGAINST A CLOSED ALLOW-LIST (src/lib/reactions.ts). This column is
/// user-controlled text on a shared table, so an open column would let anyone store arbitrary
/// strings that every participant then renders.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  // One reaction per person per emoji per message — a second tap REMOVES rather than duplicates,
  // so the database enforces what the toggle promises even if two taps race.
  @@unique([messageId, profileId, emoji])
  // The thread read fetches reactions for a page of messages at a time.
  @@index([messageId])
  // Covering index for the profileId FK, per the note on Message.senderProfileId above.
  @@index([profileId])
  // Feeds the global top-5 tally (see scripts/reaction-tally.mjs): a recent-window GROUP BY.
  @@index([createdAt])
}

// In-app notification for a recipient (new message, offer, system). Created
// server-side on the triggering event; read via /api/notifications. Display
// fields are denormalized so the bell never needs joins.
model Notification {
  id             String   @id @default(cuid())
  recipientId    String   @db.Uuid
  recipient      Profile  @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type           String // 'message' | 'offer' | 'reminder' | 'system'
  title          String // short headline (e.g. the actor's name)
  body           String? // preview text
  actorName      String? // who triggered it (denormalized display name)
  conversationId String? // deep-link target
  listingId      String?
  url            String? // generic deep-link target (e.g. a saved-search results URL)
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, read])
}

// User-submitted report of a problematic listing (scam, sold, wrong info…).
// Anonymous — no auth required to report. Feeds the /admin moderation queue.
model Report {
  id                String           @id @default(cuid())
  // A report can target a listing AND/OR an account/storefront (business or user).
  listingId         String?
  listing           Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterProfileId String?          @db.Uuid // who filed it — for trust-weighting + anti-abuse
  targetProfileId   String?          @db.Uuid // reported account (business/user), if any
  targetSellerId    String? // reported storefront, if any
  conversationId    String? // set when reported FROM a chat — links the thread for admin context
  reason            String // scam | counterfeit | wrong-info | duplicate | offensive | sold | other
  detail            String?
  severity          String? // minor | moderate | severe — set/confirmed by admin
  status            String           @default("open") // open | confirmed | dismissed | abusive
  resolvedBy        String? // admin email/id who resolved it
  resolvedAt        DateTime?
  internalNote      String? // staff-only note on the case (never shown to users)
  appealNote        String? // the reported party's appeal (re-opens the case)
  appealImages      String? // JSON array of proof image URLs submitted with the appeal
  appealedAt        DateTime? // when the target appealed (tags the case "Appeal")
  // ── Buyer-king SLA + due process (trust Phase 2). Live typed columns since
  // scripts/add-enforcement.mjs ran on prod (deploy-order @ignore dropped in Phase 3).
  sellerResponse    String? // the reported seller's reply (≤600 chars) — buyer-king SLA
  sellerRespondedAt DateTime? // unanswered >72h → "buyer waiting" flag in the admin queue
  remediatedAt      DateTime? // admin "marked remediated" → this event's conduct weight ×0.5
  // ── Repeat-false-reporter pre-screen (trust Phase 3). @ignore until
  // scripts/add-ban-evasion.mjs has run in prod — Report.create in /api/report
  // RETURNs the full row, which would 500 on the missing column. Access goes via
  // guarded raw SQL (set in /api/report, read in the admin queues) until then.
  preScreen         Boolean          @default(false) @ignore // reporter has ≥2 false-report strikes → triaged LAST, excluded from buyer-waiting
  // ── Dispute center (2026-07-07): every report IS a dispute case with a threaded
  // room (DisputeMessage) where reporter + respondent + admin exchange statements
  // and evidence, Binance-P2P style. This is the Decree 52/85-required complaint-
  // resolution mechanism — admin is always party to the thread (not open social chat).
  evidenceUntil     DateTime? // evidence window (filing + 72h; admin-extendable)
  lastMessageAt     DateTime? // last thread activity — sorts the queues
  aiAnalysis        String? // cached /api/admin/ai-review JSON (advisory)
  aiAnalyzedAt      DateTime?
  decisionNote      String? // admin's outcome note — shown to BOTH parties
  messages          DisputeMessage[]
  createdAt         DateTime         @default(now())

  @@index([listingId])
  @@index([status])
  @@index([reporterProfileId])
  @@index([targetProfileId])
  @@index([targetSellerId])
  @@index([conversationId])
}

// One entry in a dispute-case thread. senderProfileId is a bare uuid (NO FK) so the
// thread survives account deletion — resolved-report records are retained for the
// statutory period (see /privacy). Role is stamped at write time so rendering never
// re-derives identity; 'system' rows are machine-generated (decision, window events).
model DisputeMessage {
  id              String   @id @default(cuid())
  reportId        String
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  senderProfileId String?  @db.Uuid // null = admin/system (never expose admin identity)
  senderRole      String // 'reporter' | 'respondent' | 'admin' | 'system'
  body            String
  images          String? // JSON array — PRIVATE-bucket paths (disputes/<reportId>/…)
  createdAt       DateTime @default(now())

  @@index([reportId, createdAt])
}

// User feedback + technical-problem reports from the Help sheet / Help Center.
// Anonymous-friendly (no auth required) so it's frictionless; surfaces in the
// /admin/feedback queue. No Profile relation (plain optional id) to avoid FK churn.
model Feedback {
  id        String   @id @default(cuid())
  kind      String   @default("feedback") // feedback | technical | other
  message   String
  email     String? // optional reply-to the sender gave
  profileId String?  @db.Uuid // filled when sent while signed in
  url       String? // the page they were on
  userAgent String?
  status    String   @default("open") // open | resolved
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// Append-only audit log of every trust-score change. The score on Profile/Seller
// is a denormalized cache of 100 + sum(deltas); we never mutate it blindly, so
// every change is attributable and reversible.
model TrustEvent {
  id               String   @id @default(cuid())
  subjectProfileId String   @db.Uuid
  subject          Profile  @relation("SubjectTrustEvents", fields: [subjectProfileId], references: [id], onDelete: Cascade)
  type             String // report_confirmed | report_dismissed | positive_review | fast_response | engagement | decay_recover | manual_adjust
  delta            Int // signed points applied
  reason           String?
  actorId          String?  @db.Uuid // admin/user who triggered it, if any
  reportId         String? // link back to the Report, when applicable
  createdAt        DateTime @default(now())

  @@index([subjectProfileId, createdAt])
}

// One enforcement episode on a profile (trust Phase 2, DSA/Santa-Clara due process).
// Exactly ONE 'active' LADDER action per profile at a time — applyEnforcement
// supersedes the previous one (status 'lifted') on every state change. Appeals are
// one-shot per action. pulledListingIds records exactly which listings a hold pulled
// (verified→false) so a lift/overturn restores precisely those still status='active'.
// The profile's CURRENT state is denormalized onto Profile.enforcementState so hot
// write-path gates are a single indexed read.
// Phase 3 FLAG rows (reason 'velocity_review' | 'ban_evasion_email') are silent
// review ANNOTATIONS, not ladder actions: `state` records the profile's state AT
// FLAG TIME (can be good_standing), they never touch the Profile denorm, never
// notify the seller, survive ladder transitions, and close only via dismiss/act in
// the admin console (see FLAG_REASONS in src/lib/enforcement-machine.ts).
model EnforcementAction {
  id               String    @id @default(cuid())
  profileId        String    @db.Uuid
  profile          Profile   @relation("ProfileEnforcementActions", fields: [profileId], references: [id], onDelete: Cascade)
  state            String // ladder actions: warned | throttled | held | suspended · flag rows: the state at flag time
  reason           String // slug → client-side i18n copy: scam_hold | conduct_restricted | conduct_warning | insurance_grace | admin_manual | ban_evasion_review | ban_evasion_email | velocity_review
  adminNote        String? // optional admin-written notice shown to the seller with the reason copy
  triggerReportId  String? // the Report that triggered it, when applicable (no FK — reports are deletable)
  decidedBy        String // 'system' | the admin's email — precedence: system never downgrades an admin action
  status           String    @default("active") // active | lifted | expired | overturned
  expiresAt        DateTime? // timed states (30d warning, 72h insurance grace) — cron expires them
  pulledListingIds String? // JSON array of listing ids pulled by held/suspended
  appealText       String? // the seller's one-shot appeal
  appealedAt       DateTime?
  appealOutcome    String? // upheld | overturned
  appealResolvedAt DateTime?
  liftedAt         DateTime?
  createdAt        DateTime  @default(now())

  @@index([profileId, status])
  @@index([status, createdAt])
}

// Ban-evasion identity anchors (trust Phase 3). One row per SUSPENDED account,
// recording the identities we can anchor on. Phone is the anchor identity in a
// phone-verified marketplace — it's the only strong identity we hold (device/
// payment fingerprinting is deferred infra; IP linking is explicitly OUT — VN
// mobile CGNAT would false-positive whole neighborhoods). Rows are written when
// an admin suspends an account and deleted when that suspension is lifted or
// overturned (src/lib/enforcement.ts). A phone match on a NEW account never
// auto-bans — VN families share numbers, so it parks the account 'held' for a
// human review; an email match is a silent review flag only (weaker signal).
// sourceProfileId deliberately has NO FK: the ban record must SURVIVE deletion
// of the banned account — deleting the old account to free its phone for a
// "fresh" signup is exactly the evasion this table catches.
// Every query is try/catch-guarded (P2021) so code deploys safely before
// scripts/add-ban-evasion.mjs runs.
model BannedIdentity {
  id              String   @id @default(cuid())
  phone           String? // normalized +84… (same canonical form as Profile.phone)
  email           String?
  sourceProfileId String   @db.Uuid // the suspended account these identities came from
  reason          String // the enforcement reason of the suspension (audit)
  createdAt       DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@index([sourceProfileId])
}

// Machine-translation cache — avoids re-paying the translation API for the
// same source string. Keyed by a hash of the source text + target language.
model Translation {
  id        String   @id @default(cuid())
  hash      String
  target    String
  value     String
  createdAt DateTime @default(now())

  @@unique([hash, target])
  // (No target index: every lookup carries hash — the unique key serves it. Dropped 2026-10-17 by
  // scripts/listing-index-diet-ddl.mjs.)
}

// ── eno.forum ────────────────────────────────────────────────────────────────
// Forum accounts are NOT a second identity system. Every row points back to the
// existing Profile (whose id is the Supabase auth.users UUID), so marketplace
// trust, enforcement, avatar, display name, and notification delivery stay
// canonical across eno.vn and eno.forum.

model ForumProfile {
  profileId          String   @id @db.Uuid
  profile            Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bio                String?
  homeBase           String?
  residentSince      Int?
  reputation         Int      @default(0)
  postCount          Int      @default(0)
  commentCount       Int      @default(0)
  helpfulAnswerCount Int      @default(0)
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ForumCommunity {
  slug          String   @id
  name          String
  nameVi        String
  description   String
  descriptionVi String
  icon          String
  location      String?
  status        String   @default("active") // active | archived | hidden
  memberCount   Int      @default(0)
  postCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members ForumCommunityMember[]
  posts   ForumPost[]

  @@index([status, postCount])
}

model ForumCommunityMember {
  communitySlug String
  community     ForumCommunity @relation(fields: [communitySlug], references: [slug], onDelete: Cascade)
  profileId     String         @db.Uuid
  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role          String         @default("member") // member | helper | moderator | admin
  notifications Boolean        @default(true)
  joinedAt      DateTime       @default(now())

  @@id([communitySlug, profileId])
  @@index([profileId, joinedAt])
  @@index([communitySlug, role])
}

model ForumPost {
  id              String         @id @default(cuid())
  communitySlug   String
  community       ForumCommunity @relation(fields: [communitySlug], references: [slug], onDelete: Restrict)
  authorProfileId String?        @db.Uuid
  author          Profile?       @relation("ForumPostAuthor", fields: [authorProfileId], references: [id], onDelete: SetNull)
  authorName      String? // preserved display name for system/legacy posts
  authorRole      String?
  kind            String         @default("discussion") // guide | question | experience | event | discussion
  flair           String
  flairVi         String
  title           String
  body            String
  location        String         @default("all")
  locationLabel   String?
  status          String         @default("published") // draft | published | hidden | removed | locked
  pinned          Boolean        @default(false)
  official        Boolean        @default(false)
  score           Int            @default(0)
  commentCount    Int            @default(0)
  viewCount       Int            @default(0)
  hotScore        Float          @default(0)
  editedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  comments      ForumComment[]
  votes         ForumPostVote[]
  bookmarks     ForumBookmark[]
  subscriptions ForumPostSubscription[]
  media         ForumPostMedia[]
  tags          ForumPostTag[]
  reports       ForumReport[]
  moderation    ForumModerationAction[]
  revisions     ForumPostRevision[]

  @@index([status, pinned, hotScore, createdAt])
  @@index([communitySlug, status, createdAt])
  @@index([authorProfileId, createdAt])
  @@index([location, status, createdAt])
}

model ForumPostMedia {
  id          String    @id @default(cuid())
  postId      String
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  storagePath String    @unique
  mimeType    String
  width       Int?
  height      Int?
  position    Int       @default(0)
  altText     String?
  createdAt   DateTime  @default(now())

  @@unique([postId, position])
  @@index([postId])
}

model ForumComment {
  id              String         @id @default(cuid())
  postId          String
  post            ForumPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorProfileId String?        @db.Uuid
  author          Profile?       @relation("ForumCommentAuthor", fields: [authorProfileId], references: [id], onDelete: SetNull)
  authorName      String?
  authorRole      String?
  parentId        String?
  parent          ForumComment?  @relation("ForumCommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies         ForumComment[] @relation("ForumCommentTree")
  body            String
  status          String         @default("published") // published | hidden | removed
  helpful         Boolean        @default(false)
  score           Int            @default(0)
  replyCount      Int            @default(0)
  editedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  votes      ForumCommentVote[]
  reports    ForumReport[]
  moderation ForumModerationAction[]
  revisions  ForumCommentRevision[]

  @@index([postId, parentId, createdAt])
  @@index([authorProfileId, createdAt])
  @@index([parentId])
}

model ForumPostVote {
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String    @db.Uuid
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@id([postId, profileId])
  @@index([profileId, createdAt])
}

model ForumCommentVote {
  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profileId String       @db.Uuid
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@id([commentId, profileId])
  @@index([profileId, createdAt])
}

model ForumBookmark {
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String    @db.Uuid
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([postId, profileId])
  @@index([profileId, createdAt])
}

model ForumPostSubscription {
  postId    String
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileId String    @db.Uuid
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([postId, profileId])
  @@index([profileId, createdAt])
}

model ForumTag {
  slug       String   @id
  label      String
  labelVi    String
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  posts ForumPostTag[]

  @@index([usageCount])
}

model ForumPostTag {
  postId  String
  post    ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagSlug String
  tag     ForumTag  @relation(fields: [tagSlug], references: [slug], onDelete: Cascade)

  @@id([postId, tagSlug])
  @@index([tagSlug, postId])
}

model ForumUserBlock {
  blockerProfileId String   @db.Uuid
  blocker          Profile  @relation("ForumBlocker", fields: [blockerProfileId], references: [id], onDelete: Cascade)
  blockedProfileId String   @db.Uuid
  blocked          Profile  @relation("ForumBlocked", fields: [blockedProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@id([blockerProfileId, blockedProfileId])
  @@index([blockedProfileId])
}

model ForumReport {
  id                String        @id @default(cuid())
  reporterProfileId String?       @db.Uuid
  reporter          Profile?      @relation("ForumReportReporter", fields: [reporterProfileId], references: [id], onDelete: SetNull)
  targetProfileId   String?       @db.Uuid
  target            Profile?      @relation("ForumReportTarget", fields: [targetProfileId], references: [id], onDelete: SetNull)
  postId            String?
  post              ForumPost?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId         String?
  comment           ForumComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  reason            String
  detail            String?
  status            String        @default("open") // open | confirmed | dismissed | abusive
  resolvedBy        String?
  resolvedAt        DateTime?
  internalNote      String?
  createdAt         DateTime      @default(now())

  @@index([status, createdAt])
  @@index([reporterProfileId, createdAt])
  @@index([targetProfileId, createdAt])
  @@index([postId])
  @@index([commentId])
}

model ForumModerationAction {
  id                 String        @id @default(cuid())
  targetProfileId    String?       @db.Uuid
  target             Profile?      @relation("ForumModerationTarget", fields: [targetProfileId], references: [id], onDelete: SetNull)
  moderatorProfileId String?       @db.Uuid
  moderator          Profile?      @relation("ForumModerationActor", fields: [moderatorProfileId], references: [id], onDelete: SetNull)
  postId             String?
  post               ForumPost?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  commentId          String?
  comment            ForumComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  action             String // warn | hide | remove | lock | suspend
  reason             String
  note               String?
  expiresAt          DateTime?
  createdAt          DateTime      @default(now())

  @@index([targetProfileId, createdAt])
  @@index([postId, createdAt])
  @@index([commentId, createdAt])
}

model ForumPostRevision {
  id              String    @id @default(cuid())
  postId          String
  post            ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  editorProfileId String?   @db.Uuid
  editor          Profile?  @relation("ForumPostRevisionEditor", fields: [editorProfileId], references: [id], onDelete: SetNull)
  title           String
  body            String
  createdAt       DateTime  @default(now())

  @@index([postId, createdAt])
}

model ForumCommentRevision {
  id              String       @id @default(cuid())
  commentId       String
  comment         ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  editorProfileId String?      @db.Uuid
  editor          Profile?     @relation("ForumCommentRevisionEditor", fields: [editorProfileId], references: [id], onDelete: SetNull)
  body            String
  createdAt       DateTime     @default(now())

  @@index([commentId, createdAt])
}

// Saved itinerary snapshots use the same Profile identity. The generated result
// is normalized into days/stays so future AI versions can update one segment
// without replacing an opaque JSON blob.
model Itinerary {
  id              String    @id @default(cuid())
  profileId       String    @db.Uuid
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           String
  destinationId   String
  days            Int
  budgetId        String
  interests       String    @default("[]")
  status          String    @default("ready") // draft | ready | archived
  estimatedBudget Int?
  currency        String    @default("VND")
  generatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dayPlans   ItineraryDay[]
  stays      ItineraryStay[]
  assistance TripAssistanceRequest[]

  @@index([profileId, updatedAt])
  @@index([status, updatedAt])
}

model ItineraryDay {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber   Int
  area        String
  areaVi      String?
  title       String
  titleVi     String?
  morning     String
  morningVi   String?
  afternoon   String
  afternoonVi String?
  evening     String
  eveningVi   String?
  createdAt   DateTime  @default(now())

  stops ItineraryStop[]

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
}

// One mappable activity within a day. ADDITIVE: the three prose columns above
// (morning/afternoon/evening) stay exactly as they are, because trip-card.tsx and both
// docx export routes still read them — this model runs alongside, it does not replace them.
//
// It exists because the generator already produces `place`, `travelMinutes`,
// `estimatedCostVnd` and `bookingAdvice` per activity, and the save path was flattening all
// four away into `"${time} · ${title} — ${details}"`. A saved trip was therefore three prose
// blobs per day and could never be drawn on a map, which is what "manage trips booked" needs.
//
// lat/lng are NULLABLE and stops are written even when they are null: a stop with no
// coordinate is still a real stop with a name, a cost and booking advice. Only the map skips
// it. Resolving names → coordinates is a separate task; this model is just the place to put
// them when it lands.
model ItineraryStop {
  id               String       @id @default(cuid())
  dayId            String
  day              ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  // Order WITHIN the day (0 = morning, 1 = afternoon, 2 = evening today). The map draws its
  // per-day polyline in this order, so it is the stop's identity within the day, not a hint.
  position         Int
  // The searchable place — what a coordinate is resolved FROM ("Bến Thành Market").
  place            String
  // What the traveller is doing there ("Breakfast + first walk"). Distinct from `place`:
  // several activities can share one place, and the pin label wants the place.
  name             String
  time             String?
  details          String?
  lat              Float?
  lng              Float?
  travelMinutes    Int?
  estimatedCostVnd Int?
  bookingAdvice    String?
  createdAt        DateTime     @default(now())

  @@unique([dayId, position])
  @@index([dayId])
}

model ItineraryStay {
  id               String    @id @default(cuid())
  itineraryId      String
  itinerary        Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  position         Int
  name             String
  nameVi           String?
  area             String
  areaVi           String?
  note             String?
  noteVi           String?
  estimatedNightly Int?
  currency         String    @default("VND")
  createdAt        DateTime  @default(now())

  @@unique([itineraryId, position])
  @@index([itineraryId])
}

// ── Trip assistance ─────────────────────────────────────────────────────────────────
//
// The traveller asks eno to arrange an itinerary; an operator quotes a 10% service fee
// IN CHAT and the traveller pays suppliers directly. There is deliberately NO payment
// code anywhere near this: eno's filed MoIT position is "no own sales, no payment
// processing", so this stores what was AGREED, never a charge.
//
// Modelled in PRISMA, alongside Itinerary — NOT as raw Supabase tables like the visa
// desk. That split is a historical accident of the forum migration and there is no
// reason to inherit it; the compare-and-set the workflow depends on is not a Supabase
// feature, it is an UPDATE whose WHERE names the expected prior status, which Prisma
// does with updateMany + count (see src/lib/messages.ts:557, src/lib/trips/status.ts).
model TripAssistanceRequest {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  // The traveller. Cascade with the profile: an account deletion must not leave an
  // assistance case addressed to nobody.
  profileId   String    @db.Uuid
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Workflow state. The ONLY legal moves are in TRIP_TRANSITIONS (src/lib/trips/status.ts)
  // and every write goes through applyTripTransition, which compare-and-sets on the prior
  // value — so a stale operator tab cannot clobber a status somebody else already moved.
  status String @default("requested")

  // The marketplace thread this case is lived out in. A plain id, not a relation: the
  // binding is only meaningful once ownership has been PROVEN (buyer == traveller), which
  // is dm-thread's job, and an FK here would imply a validity this column cannot enforce.
  conversationId String?

  // MONEY IS OPERATOR-TYPED AND NULLABLE UNTIL QUOTED. ⚠️ No amount may ever arrive from a
  // request body — the traveller cannot propose a fee, and no client payload is trusted to
  // set either column. Both are plain VND integers; suppliers are paid directly by the
  // traveller, so nothing here is ever captured or charged.
  supplierTotalVnd Int?
  feeVnd           Int?
  quotedAt         DateTime?

  assignedAdmin String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events TripAssistanceEvent[]

  // ⚠️ TWO CHECK CONSTRAINTS live in scripts/trip-assistance-ddl.sql and have no Prisma
  // equivalent, so they are invisible here: `status` must be one of the eight names in
  // TRIP_TRANSITIONS (the NODE set, not the edges — an unknown status would strand a case
  // forever, because the machine fails closed), and a quote is BOTH money columns or neither.
  // If you add a status, edit TRIP_TRANSITIONS *and* that CHECK.
  //
  // Mirrors Itinerary's pair: one for the traveller's own list, one for the operator queue.
  @@index([profileId, updatedAt])
  @@index([status, updatedAt])
  @@index([itineraryId])
}

// Append-only audit trail. Written best-effort AFTER a committed transition, never in the
// same breath: a failed event must not report that the transition failed, because it did
// not, and telling the operator otherwise baits a re-click into an invalid transition
// (the lesson recorded at src/lib/visa-admin.ts:205-213).
model TripAssistanceEvent {
  id        String                @id @default(cuid())
  requestId String
  request   TripAssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // 'traveller' | 'admin' | 'system' — who acted. actorRef is an id or an admin email,
  // deliberately free-text so a system actor needs no fake profile.
  actorType String
  actorRef  String
  event     String

  // ⚠️ NEVER TRAVELLER PII. Ids, a step, a status pair, field NAMES — nothing else. Same
  // rule as Message.metaJson, and for the same reason: this table has no owner column and
  // outlives the case it describes.
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

// ── Payments (eno.forum ONLY) ────────────────────────────────────────────────────
// ⛔ THESE TABLES EXIST IN ONE DATABASE THAT BOTH EDITIONS SHARE, AND THAT IS NOT A LEAK.
// eno.vn cannot reach them: every payment ROUTE carries the `.forum.svc.` infix, which a
// marketplace build does not compile at all (next.config.ts), so the licensed sàn TMĐT has no
// code path that reads or writes an Order. Schema is shared; SURFACE is not. Do not "tidy" this
// by adding an edition column — a column is a runtime check, and the guarantee here is build-time.
//
// ⛔ AND THE LEGAL GATE IS NOT IN THIS FILE. Who may transact, and on which rail, is decided by
// src/lib/payments/eligibility.ts — stablecoin settlement is prohibited for Vietnamese parties, so
// `rail` being nullable here is a data shape, never a permission.

model Order {
  id         String   @id @default(cuid())
  /// The buyer's account. Uuid because Profile mirrors auth.users.
  buyerId    String   @db.Uuid
  buyer      Profile  @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  /// The shop being paid. A Seller, not a Profile: money settles to a storefront.
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  /// What was bought. Kept even if the listing is later hidden or sold.
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  /// ⛔ RESTRICT, NEVER CASCADE, ON ALL THREE. An order is a financial record: deleting an account,
  /// a shop or a listing must not delete the evidence that money moved.
  /// ⚠️ SO DELETING A LISTING THAT HAS ORDERS NOW RAISES 23503 rather than cascading, and a caller
  /// that does not catch it returns a 500 instead of "this listing has orders". Nothing in the app
  /// creates orders yet, so no delete path can hit it today — but the first one that can must
  /// handle it, and erasure must redact in place rather than delete.
  ///
  /// ⛔ AND A COMPOSITE FK BINDS (listingId, sellerId) TO Listing(id, sellerId) — see
  /// scripts/add-payments-tables.mjs. Without it these are two independent references and an order
  /// can display one shop's listing while settling to another. Prisma cannot express that shape, so
  /// the constraint lives in the DDL script and this note is the only thing pointing at it.

  /// See OrderStatus in src/lib/payments/order-state.ts. Stored as text so the state machine, not
  /// the database, owns the vocabulary — a Postgres enum would need a migration to add `shipped`.
  status     String   @default("pending")
  /// 'paypal' | 'crossmint'. Null until the seller accepts and a rail is chosen.
  rail       String?
  /// ⛔ MINOR UNITS, AND `BigInt` BECAUSE `Int` IS 32-BIT AND THAT OVERFLOWS AT $2,147.48. Two
  /// reviewers caught it: Prisma `Int` is int4 (max 2 147 483 647) and USDC carries SIX decimals,
  /// so 1 USDC is 1 000 000 minor units and any order above ~$2 147 fails to INSERT — on a
  /// marketplace that lists motorbikes, laptops and property. VND is worse: it has no minor unit,
  /// so a 3 billion đồng listing overflows on its own.
  /// ⚠️ int8 IN THE DATABASE, JS `number` IN THE STATE MACHINE. `validAmount` already refuses
  /// anything past Number.MAX_SAFE_INTEGER (2^53), which is nine quadrillion minor units — far
  /// beyond any real price — so the app layer stays on ordinary numbers and the conversion happens
  /// where Prisma hands over a bigint. Money is never a float in either layer.
  amount     BigInt
  currency   String   @default("USD")

  /// The rail's own identifier for the settlement — a Crossmint transaction id or a PayPal
  /// capture id. Unique so one rail payment can never be recorded against two different orders.
  /// ⚠️ IT IS NOT, BY ITSELF, THE ANSWER TO A CONCURRENT WEBHOOK ON THE *SAME* ORDER — a reviewer
  /// was right that two handlers writing the same ref to the same row do not violate uniqueness.
  /// The settlement write must be a CONDITIONAL update (`where status = 'awaiting_payment'`) and
  /// act only if it changed a row; the state machine refuses the replay, and the row count is what
  /// makes that refusal atomic.
  /// ⛔ THE HUMAN-FACING PAYMENT REFERENCE, AND THE ENTIRE LINK BETWEEN A BANK TRANSFER AND THIS
  /// ORDER. A VietQR buyer's banking app carries it as the transfer memo; SePay reads it back off
  /// the bank statement. See lib/payments/reference.ts — nothing else connects the two: no session,
  /// no callback, no return trip through our site.
  /// ⚠️ NOT `railRef`, which is the RAIL's own id for a payment (a bank transaction number, a chain
  /// tx hash). This one is ours and is chosen before any money moves; that one arrives afterwards.
  /// ⚠️ UNIQUE, so a generator collision is a failed insert and a retry rather than two orders
  /// quietly sharing one payment.
  reference  String   @unique
  railRef    String?  @unique

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  paidAt     DateTime?

  events     OrderEvent[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
}

/// Append-only audit of every state change. The Order row carries the CURRENT status; this carries
/// how it got there, which is what a dispute, a refund or an auditor actually needs.
/// ⚠️ WRITTEN IN THE SAME TRANSACTION AS THE STATUS UPDATE. `applyEvent` returns the next status
/// rather than mutating precisely so a caller cannot move the order without recording why.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// See OrderEventType.
  type       String
  fromStatus String
  toStatus   String
  /// Who caused it: a Profile id, or null for the system (expiry, webhook).
  actorId    String?  @db.Uuid
  /// Rail payload or admin note. Free-form on purpose; nothing branches on it.
  metaJson   String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

/// A user's non-custodial wallet, created through Crossmint.
/// ⚠️ WE STORE THE ADDRESS, NEVER A KEY. The signer is Crossmint-side (server signer authorised
/// once by the user); this row is a pointer so we can show a balance and address a transfer.
model CustodyWallet {
  id         String   @id @default(cuid())
  profileId  String   @unique @db.Uuid
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// 'crossmint' — named so a second provider does not need a table rename.
  provider   String   @default("crossmint")
  /// Chain id as the provider names it, e.g. 'base' / 'base-sepolia'. Stored because a wallet
  /// created on staging must never be addressed as if it were mainnet.
  chain      String
  address    String
  createdAt  DateTime @default(now())

  /// ⚠️ CHAIN IS IN THE KEY. The comment here used to argue that (provider, address) kept a staging
  /// wallet from colliding with a production one — which is exactly what it does NOT do, since the
  /// same address exists on `base` and `base-sepolia`. A reviewer caught the contradiction between
  /// the constraint and its own justification.
  @@unique([provider, chain, address])
  @@index([profileId])
}

/// A storage object that must be deleted once nothing references it — the DURABLE half of every
/// erasure path (account deletion, visa document replacement and deletion). Written BEFORE the
/// referencing row goes away — inside the same transaction where there is one — so a crash, a
/// timeout or a storage outage between "row gone" and "object gone" leaves a record something can
/// finish. Drained by /api/cron/storage-tombstones, which RE-CHECKS references per bucket before it
/// deletes: a tombstone for an object that is still (or again) referenced is dropped, never acted
/// on. `notBefore` gives every tombstone a grace hour so an in-flight write is never raced.
/// ⚠️ Created by scripts/storage-tombstone-table.mjs (RLS on, no anon access) — never `db push`.
model StorageTombstone {
  id        String   @id @default(cuid())
  bucket    String
  path      String
  reason    String
  createdAt DateTime @default(now())
  notBefore DateTime @default(now())
  attempts  Int      @default(0)
  lastError String?

  @@unique([bucket, path])
  @@index([notBefore])
}

/// ⛔ THE DEDUPE KEY FOR THE WHATSAPP BRIDGE, AND THE RECORD OF WHO OPENED THE CHANNEL.
/// A Meta webhook is AT-LEAST-ONCE: any delivery that does not return 200 — including one that
/// timed out after we had already committed the message — is redelivered, so without a key on
/// Meta's own `wamid` a slow night duplicates every support message. It is also the CONSENT
/// record: a support reply is relayed to WhatsApp only for a thread that has a row here, because
/// a phone on a profile is not permission to message someone from a business account.
/// ⚠️ DELIBERATELY FK-FREE, the same call schema.prisma already makes for the visa scalars: no
/// relation to Profile or Conversation, so this ships as one additive CREATE TABLE and needs no
/// edit to either hot model (and no trip through the profile_auth_fk push flow).
/// Applied by scripts/whatsapp-inbound-ddl.mjs.
model WhatsAppInbound {
  /// Meta's message id. The primary key IS the idempotency key.
  wamid          String   @id
  profileId      String   @db.Uuid
  conversationId String
  /// E.164 WITHOUT '+', exactly as Meta sends `from`/`wa_id` — the form the send API wants back.
  waId           String
  /// ⛔ NULL = CLAIMED BUT NOT YET DELIVERED. The row is written BEFORE the message so two
  /// concurrent webhook deliveries cannot both author one; this column is what stops a process
  /// that died in between from turning that claim into permanent silence, because a retry can
  /// tell an unfinished claim (take it over) from a real duplicate (skip it).
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([profileId])
  @@map("whatsapp_inbound")
}

/// ── SCHOOLS (2026-10-04): teacher-voted ranking of Saigon schools, centres and agencies ──
/// Plan + review record: ~/.claude/plans/eno-schools-2026-10-04.md. Pure logic in src/lib/schools/.
/// ⚠️ THE FOREIGN KEYS ARE THE RELATIONS BELOW (diff review: DDL-only FKs came back as DROPs in every
/// `migrate diff`): Profile CASCADE — account erasure DELETEs the Profile row (src/lib/core/account-erasure.ts),
/// taking votes and reviews with it — the reporter SET NULL, Seller SET NULL. scripts/schools-ddl.mjs adds
/// only what Prisma cannot model: CHECK constraints, the report↔review trigger, and RLS.
/// ⚠️ NO COUNTER COLUMNS. Scores, review counts and pay figures are computed at READ time from the
/// eligible rows (src/lib/schools/queries.ts): a stored counter drifts under concurrent writes and
/// cannot apply an eligibility rule that changes as accounts age (plan review, Opus + codex).
model School {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  /// language_centre | international_school | bilingual_school | agency | university (CHECK in DDL)
  kind       String
  website    String?
  /// HCMC districts of its campuses/branches, plain English labels ("District 7", "Thu Duc City").
  districts  String[] @default([])
  /// e.g. IB, Cambridge, American — schools only.
  curricula  String[] @default([])
  summary    String   @default("")
  summaryVi  String?
  /// The school's own eno.vn shop, when linked: its accounts are excluded from voting on it, and its
  /// own job posts show on the page.
  sellerId   String?  @unique // one shop ↔ at most one school (its jobs and its owner's exclusion)
  /// ⛔ SET NULL: a deleted shop unlinks the school — a dangling id would lift its owner's exclusion.
  seller     Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  /// active | hidden
  status     String   @default("active")
  /// Where the directory facts came from (seed provenance).
  sourceUrls String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  aliases SchoolAlias[]
  votes   SchoolVote[]
  reviews SchoolReview[]
  reports SchoolReport[]
  employments SchoolEmployment[]
  voteEvents  SchoolVoteEvent[]
  suggestions SchoolSuggestion[]
  awards      SchoolAward[]

  @@index([status, kind])
}

/// A teacher's PRIVATE proof that they worked at a school (2026-10-05) — what lets their review be
/// published. Reviews stay anonymous: the public sees only "Verified employee", never the profile. The proof
/// is a LinkedIn profile a MODERATOR checks (the school in Experience + a one-time code on the profile); it
/// makes someone REVIEW-eligible only — a vote counts from an identity-verified account (queries.ts).
/// ⛔ NO WORK-EMAIL PROOF, DELIBERATELY (diff review, seven rounds): a school controls its own mail domain, so
/// it could mint "employees" and, by reading codes on its own mail server, learn which staff had reviewed.
/// CHECKs and RLS: scripts/schools-ddl.mjs.
model SchoolEmployment {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profileId    String    @db.Uuid
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// linkedin (the only method; the column keeps room for a reviewed second one)
  method       String    @default("linkedin")
  /// pending | verified | rejected | withdrawn
  status       String    @default("pending")
  /// The normalised profile URL a moderator opens; nulled at purgeAt.
  linkedinUrl  String?
  /// HMAC of the normalised LinkedIn slug: one LinkedIn ↔ one eno account (SchoolProofKey). A clash is
  /// FLAGGED to the moderator, never told to the submitter (it would let anyone test a colleague's profile).
  linkedinHash String?
  /// The opaque code the teacher puts on their LinkedIn profile until a moderator has looked.
  challenge    String?
  /// Why a moderator should look twice: linkedin_shared
  flags        String[]  @default([])
  decidedAt    DateTime?
  decidedBy    String?
  rejectReason String?
  /// When linkedinUrl and challenge are erased (and an undecided proof is closed).
  purgeAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([profileId, schoolId])
  @@index([schoolId, status])
  @@index([linkedinHash])
}

/// Every LinkedIn profile that ever PROVED someone's employment (2026-10-05), as its HMAC. Append-only: the
/// FIRST account to prove a profile owns it for good, so withdrawing and re-submitting can never hand it to a
/// second account. Kept past erasure, ownerless (see profileId). RLS + CHECK: scripts/schools-ddl.mjs.
model SchoolProofKey {
  /// linkedin
  kind       String
  hash       String
  /// ⛔ SET NULL ON ERASURE, NOT CASCADE (diff review): deleting an account must not reset the ledger — a
  /// revoked profile would otherwise come back with a fresh account. What stays is an HMAC owned by no one —
  /// pseudonymous: only the server's key and a guess of the profile link it back — and it can never prove again.
  profileId  String?   @db.Uuid
  profile    Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  at         DateTime  @default(now())
  /// A moderator REVOKED a proof this key made (a rejection of a never-verified submission does not burn it — the
  /// profile may be a victim's): it can never prove employment again, for anyone.
  rejectedAt DateTime?

  @@id([kind, hash])
  @@index([profileId])
}

/// The FINGERPRINT of SCHOOL_PROOF_SECRET (2026-10-05) — an HMAC of a fixed label under that key, never the key. The
/// first edition to use the key records it; an edition whose key does not match refuses to prove anything
/// (employment.ts proofKeyMatches). Both editions share this database, so two different secrets would otherwise
/// hash one LinkedIn profile twice — and it could prove one account per edition, unflagged (diff review).
model SchoolProofKeyCheck {
  id          Int      @id @default(1)
  fingerprint String
  createdAt   DateTime @default(now())
}

/// Teachers' Choice (2026-10-05): one row per school placed in a year's category — rank 1 the year's Teachers'
/// Choice, 2–3 finalists. Written ONCE, when the year is finalised (src/lib/schools/awards.ts), and never recomputed:
/// later votes never change a past award. CHECKs and RLS: scripts/schools-ddl.mjs.
model SchoolAward {
  id         String   @id @default(cuid())
  year       Int
  /// A school kind (constants.ts SCHOOL_KINDS): each kind is its own category.
  category   String
  rank       Int
  schoolId   String
  /// ⛔ RESTRICT (diff review): a past award never disappears with its school — schools are hidden, never deleted.
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  /// Wilson lower bound (95%) of the up-share among counted votes, and what it was computed from.
  score      Float
  up         Int
  down       Int
  reviews    Int
  computedAt DateTime @default(now())

  @@unique([year, category, rank])
  @@unique([year, category, schoolId])
  @@index([schoolId])
}

/// A finalised award year (2026-10-05) — present even when no school qualified, so "final" never depends on there
/// being a winner. Its presence is what makes finalising idempotent.
model SchoolAwardYear {
  year        Int      @id
  finalisedAt DateTime @default(now())
  finalisedBy String
  /// How many votes and reviews counted across all categories (shown with the results).
  voters      Int
  reviews     Int
}

/// A school a teacher asked us to add (2026-10-05). PRIVATE: the suggester sees their own, moderators all of them.
/// A moderator adds it (creating the School with the importer's own validation), marks it a duplicate of a listed
/// school, or rejects it — a suggestion never becomes a school by itself. CHECKs and RLS: scripts/schools-ddl.mjs.
model SchoolSuggestion {
  id           String    @id @default(cuid())
  /// ⛔ CASCADE: an erased account takes its suggestions with it; a school one led to stays (it is the directory's).
  profileId    String    @db.Uuid
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  kind         String
  website      String?
  districts    String[]  @default([])
  note         String    @default("")
  /// normEmployer(name): how a second suggestion of the same school is found.
  nameKey      String
  /// The website's host for matching (src/lib/schools/suggest.ts websiteKey); null for a host many schools share.
  host         String?
  /// pending | added | duplicate | rejected
  status       String    @default("pending")
  /// The school it became (added) or already was (duplicate).
  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decidedBy    String?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([profileId, status])
  @@index([nameKey])
}

/// Append-only: every change to a school vote, 0 = withdrawn (2026-10-05). SchoolVote holds only the
/// current value; the yearly awards need each voter's last value BEFORE the cutoff.
model SchoolVoteEvent {
  id        BigInt   @id @default(autoincrement())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// +1 | -1 | 0
  value     Int
  at        DateTime @default(now())

  @@index([schoolId, at])
  @@index([profileId])
}

/// A normalised employer name (normEmployer) that a job posting may carry. The alias is the PRIMARY
/// KEY, so one employer string can never belong to two schools — an ambiguous name simply is not added
/// (plan review: "ILA" must not catch "VILA").
model SchoolAlias {
  alias    String @id
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SchoolVote {
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profileId String   @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// +1 | -1 (CHECK in DDL). Removing a vote deletes the row.
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([schoolId, profileId])
  @@index([profileId])
}

/// One review per account per school, ever: deleting sets status `removed` and writing again revives
/// the same row back to `pending`. Every write lands as `pending` — reviews are PRE-MODERATED.
model SchoolReview {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profileId    String    @db.Uuid
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// Still works there.
  current      Boolean
  /// lt1 | 1to2 | 2plus — coarse on purpose: exact years identify a teacher at a small centre.
  tenure       String
  leftYear     Int?
  /// The reviewer chose to show "left <year>".
  showLeftYear Boolean   @default(false)
  /// teacher | head_teacher | assistant | other
  role         String
  /// full_time | part_time | contract
  employment   String
  /// Branch / campus district, optional.
  district     String?
  pros         String
  cons         String
  advice       String?
  goodTags     String[]  @default([])
  badTags      String[]  @default([])
  /// ⛔ PAY IS NEVER SHOWN ON A REVIEW — only as an aggregate of ≥5 eligible reports (k-anonymity).
  payAmount    Int?
  /// VND | USD
  payCurrency  String?
  /// hour | month
  payPeriod    String?
  /// Normalised at submit; USD uses fxRate (VND per 1 USD) as of fxDate.
  payVnd       Int?
  fxRate       Float?
  fxDate       DateTime?
  /// pending | published | rejected | removed
  status       String    @default("pending")
  /// Text-screen flags for the moderator (e.g. "accusation").
  flags        String[]  @default([])
  moderatedAt  DateTime?
  moderatedBy  String?
  rejectReason String?
  /// The school's response (right of reply). Entered by eno staff for the school in v1.
  replyText    String?
  replyAt      DateTime?
  /// When the teacher last submitted this review (create OR edit). The public date and the pay report's
  /// 3-year window use it — an edit restates the pay, so the old createdAt would understate its age.
  submittedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  votes   SchoolReviewVote[]
  reports SchoolReport[]

  @@unique([schoolId, profileId])
  @@index([schoolId, status, createdAt])
  @@index([status, createdAt])
  @@index([profileId])
}

/// "Helpful / not helpful" on a review. Counted at read time with the same eligibility as school votes.
model SchoolReviewVote {
  reviewId  String
  review    SchoolReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  profileId String       @db.Uuid
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  value     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@id([reviewId, profileId])
  @@index([profileId])
}

/// A teacher's report on a review, or a school's complaint (the right-of-reply channel).
/// ⛔ NEVER AUTO-HIDES ANYTHING — three throwaway accounts must not be able to delete criticism. Every
/// row goes to the admin queue; complaints carry a 24 h due-by there.
model SchoolReport {
  id                String        @id @default(cuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reviewId          String?
  /// ⛔ SET NULL, not Cascade: erasing the reviewer's account deletes the review, but a complaint or
  /// report ABOUT it is the moderation trail and stays (diff review, Opus).
  review            SchoolReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  /// review_report | school_complaint
  kind              String
  reporterProfileId String?       @db.Uuid
  reporter          Profile?      @relation(fields: [reporterProfileId], references: [id], onDelete: SetNull)
  reason            String
  detail            String?
  /// School complaints only — how staff answer the school.
  contactEmail      String?
  /// open | resolved | dismissed
  status            String        @default("open")
  resolvedBy        String?
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@index([status, createdAt])
  @@index([reviewId])
  @@index([schoolId])
}

// ── eno CLASSROOM (owner, 2026-10-25) ──────────────────────────────────────────────────────────────────────────────
// A teacher's AI talking avatar that their students practise speaking English with at home; the teacher sees what went
// wrong after every session and edits what the next one works on. Plan: ~/.claude/plans/we-need-to-create-scalable-cocoa.md.
// ⛔ THE TABLES ARE MADE BY scripts/classroom-ddl.mjs (CHECKs, the partial unique indexes Prisma cannot declare, RLS on):
// src/lib/classroom/ddl.test.ts reads both files and fails if a column drifts. Never `db push` (prisma/CLAUDE.md).
// ⛔ NO LEARNER AUDIO IS STORED ANYWHERE: pronunciation is scored on the clip in memory and the clip is dropped.

/// One avatar per teacher (MVP). Built on the teacher's TeacherProfile; deleting the profile deletes the classroom.
model ClassroomAvatar {
  id                     String                @id @default(cuid())
  teacherProfileId       String                @unique
  teacherProfile         TeacherProfile        @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  /// The name students see ("Ms Anna"), always shown with "AI avatar of …" (Spatius Terms §4.4).
  name                   String
  /// The character the tutor plays — the teacher's words (or Write with AI's, kept only if the teacher saves them).
  persona                String                @default("")
  /// Tone / pace / topics chips: { tone, pace, topics } (src/lib/classroom/persona.ts).
  traits                 Json                  @default("{}")
  /// The avatar's first line to a new student (the first plan's opening line).
  greeting               String                @default("")
  /// An Azure neural voice name from src/lib/classroom/voices.ts (the allowlist the API checks).
  voice                  String
  look                   String                @default("photo") // photo | library | custom
  /// A ready-made Spatius avatar id from src/lib/classroom/library-avatars.ts.
  libraryAvatarId        String?
  /// The teacher's own face: requested → (made by hand in Spatius Studio from the profile photo) → ready; removed on withdrawal.
  customStatus           String                @default("none") // none | requested | ready | removed
  /// The likeness at Spatius, pasted by an admin (/admin/classroom). Unique: deleting or replacing one avatar's id queues
  /// THAT likeness for deletion (the DDL's trigger), so no two avatars may share one. 4–120 characters (the queue's bounds).
  spatiusAvatarId        String?               @unique
  /// The "Use my photo" consent (a biometric likeness held by SpatialWalk Pte Ltd): version + time, and its withdrawal.
  photoConsentVersion    String?
  photoConsentAt         DateTime?
  photoWithdrawnAt       DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now()) @updatedAt
  seats                  ClassroomEnrollment[]
  sessions               ClassroomSession[]
}

/// Who practises: the account holder (kind self, 18+) or a child they are parent or legal guardian of (kind child — no login
/// of its own). Deleting it erases every seat, session and report of that learner (the cascade below).
model ClassroomLearner {
  id                        String                @id @default(cuid())
  ownerId                   String                @db.Uuid
  owner                     Profile               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind                      String // self | child
  /// A first name or nickname — what the teacher's roster shows. Nothing else identifies a child.
  displayName               String
  /// Children only: the YEAR alone (age band for the tutor; assent from 7; voice-only under 13).
  birthYear                 Int?
  /// Purpose 1 — voice practice (audio to Microsoft for the transcript and scores, text to Google): version + time.
  practiceConsentVersion    String?
  practiceConsentAt         DateTime?
  /// Purpose 2 — the teacher sees transcripts and reports.
  teacherViewConsentVersion String?
  teacherViewConsentAt      DateTime?
  /// Children only: the account holder said they are the child's parent or legal guardian.
  guardianAttestedAt        DateTime?
  /// "Me": the account holder's own statement that they are 18+ and the one who practises (notices.ts ADULT_ATTESTATION);
  /// required for kind self (a CHECK). A child has guardianAttestedAt instead.
  adultAttestedAt           DateTime?
  /// Children aged 7+: the child's own "yes" on the assent screen.
  assentAt                  DateTime?
  /// Consent withdrawn: practice stops; the learner's data stays only as long as the seat's retention allows.
  withdrawnAt               DateTime?
  /// The avatar's voice pace this learner asked for ("talk more slowly") — slowest | gentle | natural | quick; null = the
  /// default for their age and level (src/lib/classroom/pace.ts). Read back inside their age's bounds.
  voicePace                 String?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @default(now()) @updatedAt
  seats                     ClassroomEnrollment[]
  sessions                  ClassroomSession[]

  @@index([ownerId])
}

/// A SEAT in a teacher's class: made by the teacher with its settings, claimed through a one-use invite.
model ClassroomEnrollment {
  id              String             @id @default(cuid())
  avatarId        String
  avatar          ClassroomAvatar    @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  /// Null until the invite is claimed.
  learnerId       String?
  learner         ClassroomLearner?  @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  /// The teacher's own label for the seat ("Minh — Grade 3"), shown on the invite.
  seatName        String
  /// One-use: cleared when claimed (or the seat removed). Unguessable (src/lib/classroom/invite-code.ts).
  inviteCode      String?            @unique
  inviteExpiresAt DateTime?
  status          String             @default("invited") // invited | active | paused | removed
  level           String             @default("A2")
  sessionMinutes  Int                @default(10)
  sessionsPerWeek Int                @default(3)
  strictness      String             @default("balanced")
  /// The teacher's standing note for every session ("she is shy — praise first").
  focusNote       String             @default("")
  /// "Working on": recurring mistakes the next sessions bring back until fixed (src/lib/classroom/focus.ts).
  focusItems      Json               @default("[]")
  claimedAt       DateTime?
  removedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
  plans           ClassroomPlan[]
  sessions        ClassroomSession[]

  @@index([avatarId, status])
  @@index([learnerId])
}

/// What one session works on. The AI drafts the next one after every report; a teacher's edit always wins.
model ClassroomPlan {
  id            String              @id @default(cuid())
  enrollmentId  String
  enrollment    ClassroomEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  source        String // ai | teacher
  status        String              @default("draft") // draft | approved | used
  /// The scenario and goals in plain words — what the teacher reads and edits.
  brief         String
  /// { goals[], focusWords[], recycle[], drill[] } (src/lib/classroom/plans.ts).
  focus         Json                @default("{}")
  /// The avatar's first line — spoken without a model call, so a session starts at once.
  openingLine   String              @default("")
  /// The session whose report drafted it (null for the first plan). A HISTORICAL id, deliberately not a relation (round 6,
  /// codex): that session may be erased later, and the plan stands on its own.
  fromSessionId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt

  @@index([enrollmentId, status])
}

/// One practice session. ⛔ ONE LIVE SESSION PER LEARNER (and per teacher test) — a partial unique index in the DDL.
model ClassroomSession {
  id               String               @id @default(cuid())
  /// Null = the teacher's own test of their avatar.
  enrollmentId     String?
  enrollment       ClassroomEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  avatarId         String
  avatar           ClassroomAvatar      @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  /// Copied from the seat (session-start.ts) so the one-live-session index can see it; null for a teacher test. The
  /// session's OWN learner — report access follows it, never the seat's (report.ts).
  learnerId        String?
  learner          ClassroomLearner?    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  /// A teacher test: the teacher's profile id; null for a learner session.
  testerId         String?              @db.Uuid
  /// The plan this session was started from — a HISTORICAL id, deliberately not a relation (round 6, codex): an AI draft is
  /// replaced by the next report's, so the row may be gone. planSnapshot below is what the session actually ran.
  planId           String?
  /// The plan as it was when the session started (a later edit never rewrites what this session was asked to do).
  planSnapshot     Json                 @default("{}")
  status           String               @default("live") // live | ended
  endReason        String? // learner | time | abandoned | kill_switch
  mode             String               @default("avatar") // avatar | voice
  startedAt        DateTime             @default(now())
  /// The hard end: no turn lands after endsAt + LIMITS.deadlineGraceSeconds.
  endsAt           DateTime
  endedAt          DateTime?
  /// What the budget counts while the session is live (released to usedSeconds at the end).
  reservedMinutes  Int
  usedSeconds      Int                  @default(0)
  tokenMints       Int                  @default(0)
  turnCount        Int                  @default(0)
  learnerSpeechMs  Int                  @default(0)
  avatarChars      Int                  @default(0)
  /// Estimated vendor cost (Spatius + Azure + Gemini) in millionths of a US dollar — logged, never billed.
  costMicroUsd     Int                  @default(0)
  feedbackStatus   String               @default("pending") // pending | ready | failed
  feedbackAttempts Int                  @default(0)
  /// The avatar's voice pace NOW (src/lib/classroom/pace.ts) — set at the start, moved a step by the learner's request.
  voicePace        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  turns            ClassroomTurn[]
  feedback         ClassroomFeedback?

  @@index([status, endsAt])
  @@index([enrollmentId, startedAt])
  @@index([avatarId, startedAt])
  @@index([learnerId, startedAt])
}

/// One exchange: what the learner said (seq ≥ 1) and the avatar's reply. seq 0 is the avatar's opening line.
model ClassroomTurn {
  id           String           @id @default(cuid())
  sessionId    String
  session      ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq          Int
  /// The client's idempotency key: a retried upload is the same turn, never a second one.
  clientTurnId String?
  status       String           @default("processing") // processing | ok | failed
  learnerText  String?
  replyText    String           @default("")
  hint         String           @default("")
  hintVi       String           @default("")
  /// The sentence this REPLY asks the learner to repeat — the known reference that scores their next turn.
  expectText   String?
  /// The reference the pronunciation score of THIS turn used: the previous reply's expectText, else the transcript.
  reference    String?
  /// Sound-alike mishearings the model suspects: [{ heard, meant }] — shown as questions, never as scores.
  heardAs      Json             @default("[]")
  /// Azure Pronunciation Assessment, trimmed: { accuracy, fluency, prosody, words: [{ word, score, error, phonemes? }] }.
  pron         Json?
  assessStatus String           @default("skipped") // pending | done | failed | skipped
  /// 'harm': the learner mentioned harm; the tutor answered with "tell a trusted adult" (teacher-only, and eno admin).
  flag         String?
  /// How many Gemini calls this reply took (the hedge's second seat and the fallback counted) — for the cost estimate.
  aiCalls      Int              @default(0)
  learnerMs    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@unique([sessionId, seq])
  @@unique([sessionId, clientTurnId])
}

/// The report after a session — what the learner (or their parent) and the teacher read.
model ClassroomFeedback {
  sessionId     String           @id
  session       ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  summary       String
  /// The same summary in Vietnamese — for the learner's family.
  summaryVi     String           @default("")
  wins          Json             @default("[]")
  /// [{ said, better, type, why, turn }] — ⛔ `said` must appear in a learner turn, or the item is dropped.
  mistakes      Json             @default("[]")
  /// [{ word, score, tip, reliable }] from Azure's scores (reliable = scored against a known drill sentence).
  pronunciation Json             @default("[]")
  /// { used[], missed[], new[] }
  vocabulary    Json             @default("{}")
  /// { pronunciation, fluency, grammarFixes, talkSeconds }
  scores        Json             @default("{}")
  /// Teacher-only: the child mentioned harm; the tutor answered with "talk to a trusted adult". Also logged for eno admin.
  safetyFlag    String?
  /// The teacher's private note — never shown to the learner.
  teacherNote   String           @default("")
  teacherSeenAt DateTime?
  learnerSeenAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
}

/// ⛔ ONE ROW PER DISCLOSURE OF A TEACHER'S ZALO (owner, 2026-10-28 — src/lib/teachers/zalo.ts): which school saw which
/// grant of the number, and when. The school's daily cap counts its rows of the day; a school re-opening the SAME grant
/// adds nothing (the unique key) and is never counted or rung twice, while a NEW grant (a changed number, switched off
/// and on) is a new disclosure: counted, rung, recorded. The teacher's record of who saw it outlives the school's
/// account: `viewerProfileId` goes NULL with it and `viewerName` keeps the name the school had then. The day's COUNTS
/// outlive the teacher's profile (review, 2026-10-28: a cascade would hand a school its spent reveal back): the profile
/// gone, `teacherProfileId` goes NULL and the row is only a count, swept two days later. `poolKey` (an HMAC of the
/// connection, dm-quota.ts poolKeyFor's idiom) is set on a reveal by an account below business verification — the shared
/// daily pool of one connection counts those — and erased after two days (zalo.ts sweepZalo, the daily retention cron).
/// Table: scripts/teacher-zalo-ddl.mjs (RLS on, no policy).
model TeacherZaloReveal {
  id               String          @id @default(cuid())
  viewerProfileId  String?         @db.Uuid
  viewer           Profile?        @relation(fields: [viewerProfileId], references: [id], onDelete: SetNull)
  viewerName       String
  teacherProfileId String?
  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: SetNull)
  grantAt          DateTime
  day              String
  poolKey          String?
  revealedAt       DateTime       @default(now())

  @@unique([viewerProfileId, teacherProfileId, grantAt])
  @@index([viewerProfileId, day])
  @@index([teacherProfileId, day])
  @@index([poolKey, day])
}
