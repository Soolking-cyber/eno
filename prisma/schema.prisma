// Saved itinerary snapshots use the same Profile identity. The generated result
// is normalized into days/stays so future AI versions can update one segment
// without replacing an opaque JSON blob.
model Itinerary {
  id              String    @id @default(cuid())
  profileId       String    @db.Uuid
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           String
  destinationId   String
  days            Int
  budgetId        String
  interests       String    @default("[]")
  status          String    @default("ready") // draft | ready | archived
  estimatedBudget Int?
  currency        String    @default("VND")
  generatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dayPlans   ItineraryDay[]
  stays      ItineraryStay[]
  assistance TripAssistanceRequest[]

  @@index([profileId, updatedAt])
  @@index([status, updatedAt])
}

model ItineraryDay {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber   Int
  area        String
  areaVi      String?
  title       String
  titleVi     String?
  morning     String
  morningVi   String?
  afternoon   String
  afternoonVi String?
  evening     String
  eveningVi   String?
  createdAt   DateTime  @default(now())

  stops ItineraryStop[]

  @@unique([itineraryId, dayNumber])
  @@index([itineraryId])
}

// One mappable activity within a day. ADDITIVE: the three prose columns above
// (morning/afternoon/evening) stay exactly as they are, because trip-card.tsx and both
// docx export routes still read them — this model runs alongside, it does not replace them.
//
// It exists because the generator already produces `place`, `travelMinutes`,
// `estimatedCostVnd` and `bookingAdvice` per activity, and the save path was flattening all
// four away into `"${time} · ${title} — ${details}"`. A saved trip was therefore three prose
// blobs per day and could never be drawn on a map, which is what "manage trips booked" needs.
//
// lat/lng are NULLABLE and stops are written even when they are null: a stop with no
// coordinate is still a real stop with a name, a cost and booking advice. Only the map skips
// it. Resolving names → coordinates is a separate task; this model is just the place to put
// them when it lands.
model ItineraryStop {
  id               String       @id @default(cuid())
  dayId            String
  day              ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  // Order WITHIN the day (0 = morning, 1 = afternoon, 2 = evening today). The map draws its
  // per-day polyline in this order, so it is the stop's identity within the day, not a hint.
  position         Int
  // The searchable place — what a coordinate is resolved FROM ("Bến Thành Market").
  place            String
  // What the traveller is doing there ("Breakfast + first walk"). Distinct from `place`:
  // several activities can share one place, and the pin label wants the place.
  name             String
  time             String?
  details          String?
  lat              Float?
  lng              Float?
  travelMinutes    Int?
  estimatedCostVnd Int?
  bookingAdvice    String?
  createdAt        DateTime     @default(now())

  @@unique([dayId, position])
  @@index([dayId])
}

model ItineraryStay {
  id               String    @id @default(cuid())
  itineraryId      String
  itinerary        Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  position         Int
  name             String
  nameVi           String?
  area             String
  areaVi           String?
  note             String?
  noteVi           String?
  estimatedNightly Int?
  currency         String    @default("VND")
  createdAt        DateTime  @default(now())

  @@unique([itineraryId, position])
  @@index([itineraryId])
}

// ── Trip assistance ─────────────────────────────────────────────────────────────────
//
// The traveller asks eno to arrange an itinerary; an operator quotes a 10% service fee
// IN CHAT and the traveller pays suppliers directly. There is deliberately NO payment
// code anywhere near this: eno's filed MoIT position is "no own sales, no payment
// processing", so this stores what was AGREED, never a charge.
//
// Modelled in PRISMA, alongside Itinerary — NOT as raw Supabase tables like the visa
// desk. That split is a historical accident of the forum migration and there is no
// reason to inherit it; the compare-and-set the workflow depends on is not a Supabase
// feature, it is an UPDATE whose WHERE names the expected prior status, which Prisma
// does with updateMany + count (see src/lib/messages.ts:557, src/lib/trips/status.ts).
model TripAssistanceRequest {
  id          String    @id @default(cuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  // The traveller. Cascade with the profile: an account deletion must not leave an
  // assistance case addressed to nobody.
  profileId   String    @db.Uuid
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Workflow state. The ONLY legal moves are in TRIP_TRANSITIONS (src/lib/trips/status.ts)
  // and every write goes through applyTripTransition, which compare-and-sets on the prior
  // value — so a stale operator tab cannot clobber a status somebody else already moved.
  status String @default("requested")

  // The marketplace thread this case is lived out in. A plain id, not a relation: the
  // binding is only meaningful once ownership has been PROVEN (buyer == traveller), which
  // is dm-thread's job, and an FK here would imply a validity this column cannot enforce.
  conversationId String?

  // MONEY IS OPERATOR-TYPED AND NULLABLE UNTIL QUOTED. ⚠️ No amount may ever arrive from a
  // request body — the traveller cannot propose a fee, and no client payload is trusted to
  // set either column. Both are plain VND integers; suppliers are paid directly by the
  // traveller, so nothing here is ever captured or charged.
  supplierTotalVnd Int?
  feeVnd           Int?
  quotedAt         DateTime?

  assignedAdmin String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  events TripAssistanceEvent[]

  // ⚠️ TWO CHECK CONSTRAINTS live in scripts/trip-assistance-ddl.sql and have no Prisma
  // equivalent, so they are invisible here: `status` must be one of the eight names in
  // TRIP_TRANSITIONS (the NODE set, not the edges — an unknown status would strand a case
  // forever, because the machine fails closed), and a quote is BOTH money columns or neither.
  // If you add a status, edit TRIP_TRANSITIONS *and* that CHECK.
  //
  // Mirrors Itinerary's pair: one for the traveller's own list, one for the operator queue.
  @@index([profileId, updatedAt])
  @@index([status, updatedAt])
  @@index([itineraryId])
}

// Append-only audit trail. Written best-effort AFTER a committed transition, never in the
// same breath: a failed event must not report that the transition failed, because it did
// not, and telling the operator otherwise baits a re-click into an invalid transition
// (the lesson recorded at src/lib/visa-admin.ts:205-213).
model TripAssistanceEvent {
  id        String                @id @default(cuid())
  requestId String
  request   TripAssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // 'traveller' | 'admin' | 'system' — who acted. actorRef is an id or an admin email,
  // deliberately free-text so a system actor needs no fake profile.
  actorType String
  actorRef  String
  event     String

  // ⚠️ NEVER TRAVELLER PII. Ids, a step, a status pair, field NAMES — nothing else. Same
  // rule as Message.metaJson, and for the same reason: this table has no owner column and
  // outlives the case it describes.
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

// ── Payments (eno.forum ONLY) ────────────────────────────────────────────────────
// ⛔ THESE TABLES EXIST IN ONE DATABASE THAT BOTH EDITIONS SHARE, AND THAT IS NOT A LEAK.
// eno.vn cannot reach them: every payment ROUTE carries the `.forum.svc.` infix, which a
// marketplace build does not compile at all (next.config.ts), so the licensed sàn TMĐT has no
// code path that reads or writes an Order. Schema is shared; SURFACE is not. Do not "tidy" this
// by adding an edition column — a column is a runtime check, and the guarantee here is build-time.
//
// ⛔ AND THE LEGAL GATE IS NOT IN THIS FILE. Who may transact, and on which rail, is decided by
// src/lib/payments/eligibility.ts — stablecoin settlement is prohibited for Vietnamese parties, so
// `rail` being nullable here is a data shape, never a permission.

model Order {
  id         String   @id @default(cuid())
  /// The buyer's account. Uuid because Profile mirrors auth.users.
  buyerId    String   @db.Uuid
  buyer      Profile  @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  /// The shop being paid. A Seller, not a Profile: money settles to a storefront.
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  /// What was bought. Kept even if the listing is later hidden or sold.
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  /// ⛔ RESTRICT, NEVER CASCADE, ON ALL THREE. An order is a financial record: deleting an account,
  /// a shop or a listing must not delete the evidence that money moved.
  /// ⚠️ SO DELETING A LISTING THAT HAS ORDERS NOW RAISES 23503 rather than cascading, and a caller
  /// that does not catch it returns a 500 instead of "this listing has orders". Nothing in the app
  /// creates orders yet, so no delete path can hit it today — but the first one that can must
  /// handle it, and erasure must redact in place rather than delete.
  ///
  /// ⛔ AND A COMPOSITE FK BINDS (listingId, sellerId) TO Listing(id, sellerId) — see
  /// scripts/add-payments-tables.mjs. Without it these are two independent references and an order
  /// can display one shop's listing while settling to another. Prisma cannot express that shape, so
  /// the constraint lives in the DDL script and this note is the only thing pointing at it.

  /// See OrderStatus in src/lib/payments/order-state.ts. Stored as text so the state machine, not
  /// the database, owns the vocabulary — a Postgres enum would need a migration to add `shipped`.
  status     String   @default("pending")
  /// 'paypal' | 'crossmint'. Null until the seller accepts and a rail is chosen.
  rail       String?
  /// ⛔ MINOR UNITS, AND `BigInt` BECAUSE `Int` IS 32-BIT AND THAT OVERFLOWS AT $2,147.48. Two
  /// reviewers caught it: Prisma `Int` is int4 (max 2 147 483 647) and USDC carries SIX decimals,
  /// so 1 USDC is 1 000 000 minor units and any order above ~$2 147 fails to INSERT — on a
  /// marketplace that lists motorbikes, laptops and property. VND is worse: it has no minor unit,
  /// so a 3 billion đồng listing overflows on its own.
  /// ⚠️ int8 IN THE DATABASE, JS `number` IN THE STATE MACHINE. `validAmount` already refuses
  /// anything past Number.MAX_SAFE_INTEGER (2^53), which is nine quadrillion minor units — far
  /// beyond any real price — so the app layer stays on ordinary numbers and the conversion happens
  /// where Prisma hands over a bigint. Money is never a float in either layer.
  amount     BigInt
  currency   String   @default("USD")

  /// The rail's own identifier for the settlement — a Crossmint transaction id or a PayPal
  /// capture id. Unique so one rail payment can never be recorded against two different orders.
  /// ⚠️ IT IS NOT, BY ITSELF, THE ANSWER TO A CONCURRENT WEBHOOK ON THE *SAME* ORDER — a reviewer
  /// was right that two handlers writing the same ref to the same row do not violate uniqueness.
  /// The settlement write must be a CONDITIONAL update (`where status = 'awaiting_payment'`) and
  /// act only if it changed a row; the state machine refuses the replay, and the row count is what
  /// makes that refusal atomic.
  railRef    String?  @unique

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  paidAt     DateTime?

  events     OrderEvent[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
}

/// Append-only audit of every state change. The Order row carries the CURRENT status; this carries
/// how it got there, which is what a dispute, a refund or an auditor actually needs.
/// ⚠️ WRITTEN IN THE SAME TRANSACTION AS THE STATUS UPDATE. `applyEvent` returns the next status
/// rather than mutating precisely so a caller cannot move the order without recording why.
model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// See OrderEventType.
  type       String
  fromStatus String
  toStatus   String
  /// Who caused it: a Profile id, or null for the system (expiry, webhook).
  actorId    String?  @db.Uuid
  /// Rail payload or admin note. Free-form on purpose; nothing branches on it.
  metaJson   String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

/// A user's non-custodial wallet, created through Crossmint.
/// ⚠️ WE STORE THE ADDRESS, NEVER A KEY. The signer is Crossmint-side (server signer authorised
/// once by the user); this row is a pointer so we can show a balance and address a transfer.
model CustodyWallet {
  id         String   @id @default(cuid())
  profileId  String   @unique @db.Uuid
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// 'crossmint' — named so a second provider does not need a table rename.
  provider   String   @default("crossmint")
  /// Chain id as the provider names it, e.g. 'base' / 'base-sepolia'. Stored because a wallet
  /// created on staging must never be addressed as if it were mainnet.
  chain      String
  address    String
  createdAt  DateTime @default(now())

  /// ⚠️ CHAIN IS IN THE KEY. The comment here used to argue that (provider, address) kept a staging
  /// wallet from colliding with a production one — which is exactly what it does NOT do, since the
  /// same address exists on `base` and `base-sepolia`. A reviewer caught the contradiction between
  /// the constraint and its own justification.
  @@unique([provider, chain, address])
  @@index([profileId])
}
