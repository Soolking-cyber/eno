{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build && { [ -d .next/standalone ] && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ || true; }",
    "start": "NODE_ENV=production node .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "content:check": "node scripts/content-integrity.mjs",
    "sec:probe": "node scripts/sec-probe.mjs",
    "verify": "node scripts/check-all.mjs",
    "verify:offline": "node scripts/check-all.mjs --offline",
    "e2e": "playwright test",
    "e2e:guest": "playwright test --project=guest-desktop --project=guest-mobile",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "db:push": "prisma db push",
    "db:setup": "prisma db push && node scripts/messaging-realtime.mjs && node scripts/unique-constraints.mjs && node scripts/image-hash-index.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.82.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "heic-to": "^1.5.2",
    "hls.js": "^1.6.16",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.525.0",
    "next": "^16.2.10",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.17.1",
    "sharp": "^0.34.3",
    "simple-icons": "^16.24.0",
    "sonner": "^2.0.6",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
